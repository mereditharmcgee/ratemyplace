---
// The email verification step on /review/new and /review/edit/[id], shown in place of the
// form to a signed-in account whose email is not verified (src/lib/emailVerification.ts).
// The copy and the resend status rule live in src/lib/contributionCopy.ts; this only renders
// them. It never shows the email address.
//
// The script posts to the resend route and writes the outcome into the status region, which
// is on the page from the start so the result is announced. On "already verified" (the
// account was verified in another tab or on another device) it reloads, and the form renders.
import { EMAIL_GATE_COPY } from '../../lib/contributionCopy';
import { REVIEW_SIGNIN_COPY } from '../../lib/reviewSignin';

interface Props {
  /** The building being reviewed ("address, city"), or null when the page names none we can show. */
  place: string | null;
}

const { place } = Astro.props;
const headingId = 'email-verification-gate-heading';
---

<section
  class="bg-white rounded-[6px] border border-slate-200 p-6"
  aria-labelledby={headingId}
  data-email-verification-gate
>
  <h2 id={headingId} class="text-lg font-semibold text-gray-900">{EMAIL_GATE_COPY.heading}</h2>
  {place && <p class="mt-3 font-semibold text-gray-900" data-email-gate-place>{REVIEW_SIGNIN_COPY.reviewing(place)}</p>}
  <p class="mt-3 text-gray-700">{EMAIL_GATE_COPY.why}</p>
  {EMAIL_GATE_COPY.residencyNote && <p class="mt-3 text-sm text-gray-600">{EMAIL_GATE_COPY.residencyNote}</p>}
  <button
    type="button"
    class="mt-5 bg-teal-700 text-white font-semibold py-2 px-4 rounded-[4px] hover:bg-teal-800 transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-700 disabled:opacity-50 disabled:cursor-not-allowed"
    data-email-gate-resend
  >{EMAIL_GATE_COPY.resend}</button>
  <p role="status" class="mt-3 text-sm text-gray-700 empty:mt-0" data-email-gate-status></p>
</section>

<script>
  import { EMAIL_GATE_COPY, gateResendOutcome } from '../../lib/contributionCopy';

  /** The status line to show, or null to reload the page (the account is verified now). */
  async function resend(): Promise<string | null> {
    try {
      const response = await fetch('/api/auth/resend-verification', {
        method: 'POST',
        credentials: 'same-origin',
      });
      let body: unknown = null;
      try {
        body = await response.json();
      } catch {
        // Not JSON (Astro's plain-text origin 403, for one): gateResendOutcome says "failed".
      }
      const outcome = gateResendOutcome(response.status, body);
      return outcome.kind === 'reload' ? null : outcome.text;
    } catch {
      return EMAIL_GATE_COPY.failed;
    }
  }

  for (const gate of document.querySelectorAll<HTMLElement>('[data-email-verification-gate]')) {
    const button = gate.querySelector<HTMLButtonElement>('[data-email-gate-resend]');
    const status = gate.querySelector<HTMLElement>('[data-email-gate-status]');
    if (!button || !status) continue;

    button.addEventListener('click', async () => {
      button.disabled = true;
      button.textContent = EMAIL_GATE_COPY.sending;
      status.textContent = '';

      const text = await resend();
      if (text === null) {
        window.location.reload();
        return;
      }

      status.textContent = text;
      button.disabled = false;
      button.textContent = EMAIL_GATE_COPY.resend;
      // Disabling the button dropped focus to the page: give it back, so the next Tab starts here.
      if (!document.activeElement || document.activeElement === document.body) button.focus();
    });
  }
</script>
