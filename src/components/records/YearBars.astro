---
// How many records the city filed each year, as bars. One ink for a year with records and a
// lighter one for a year without, and no second colour anywhere: a bar is tall because more
// rows were recorded that year, and the chart says nothing else.
//
// Every year in the span gets a bar, including the empty ones. Dropping a zero year would
// close a gap the records actually have and make an intermittent run look continuous.
//
// A year the city's own file is empty for is different: its zero is not a count. Those years
// arrive in `missingYears` (worked out in `ledger.ts`) and draw as a dashed, unfilled outline
// instead of a bar, with `missingNote` under the chart saying why.
import type { YearCount } from '../../lib/records/charts';
import { yearChartLabel, type CountNoun } from '../../lib/records/display';

interface Props {
  title: string;
  series: YearCount[];
  /** The noun for the accessible description, in both numbers, e.g. request / requests. */
  noun: CountNoun;
  /** Years in the series with no data from the city, drawn as missing rather than as zero. */
  missingYears?: readonly number[];
  /** The line under the chart that says why those years are missing. */
  missingNote?: string | null;
}

const { title, series, noun, missingYears = [], missingNote = null } = Astro.props;
const missing = new Set(missingYears);

const BAR_AREA_PX = 64;
/** A year with no records still draws, so the axis reads as a continuous span. */
const MIN_BAR_PX = 2;

const total = series.reduce((sum, entry) => sum + entry.count, 0);
const max = series.reduce((highest, entry) => Math.max(highest, entry.count), 0);

/** Past sixteen columns a label under every year runs the digits together, so only the years
 *  divisible by five keep one — the axis stays readable without losing either end's context. */
const DENSE_LABEL_LIMIT = 16;
/** Four digits per column stop fitting past eight labels, so the century is dropped instead. */
const ABBREVIATE_ABOVE = 8;

const labelled = new Set(
  series.length <= DENSE_LABEL_LIMIT
    ? series.map((entry) => entry.year)
    : series.filter((entry) => entry.year % 5 === 0).map((entry) => entry.year),
);
const abbreviate = labelled.size > ABBREVIATE_ABOVE;

function barHeight(count: number): number {
  if (max === 0) return MIN_BAR_PX;
  return Math.max(MIN_BAR_PX, Math.round((count / max) * BAR_AREA_PX));
}

function axisLabel(year: number): string {
  if (!labelled.has(year)) return '';
  return abbreviate ? `’${String(year).slice(2)}` : String(year);
}

// The frontmatter runs whether or not the markup below renders, so the empty case still has
// to be handled here even though the JSX only reaches `ariaLabel` behind `series.length > 0`.
const missingInSeries = series.filter((entry) => missing.has(entry.year)).map((entry) => entry.year);
const ariaLabel =
  series.length > 0
    ? yearChartLabel(title, total, noun, series[0].year, series[series.length - 1].year, missingInSeries)
    : '';
---

{series.length > 0 && (
  <div>
    <h5 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{title}</h5>
    <div role="img" aria-label={ariaLabel} class="mt-2 flex items-end gap-px" style={`height:${BAR_AREA_PX}px`}>
      {/* Capped so a one- or two-year span draws bars rather than a wall of ink. A long span
          never reaches the cap, so the chart still fills its column. */}
      {series.map((entry) =>
        missing.has(entry.year) ? (
          <span class="flex max-w-8 flex-1 items-end" title={`${entry.year}: no data`} data-missing-year={entry.year}>
            <span class="block w-full border border-dashed border-gray-400" style={`height:${BAR_AREA_PX}px`}></span>
          </span>
        ) : (
          <span class="flex max-w-8 flex-1 items-end" title={`${entry.year}: ${entry.count}`}>
            <span
              class:list={['block w-full', entry.count > 0 ? 'bg-gray-700' : 'bg-gray-200']}
              style={`height:${barHeight(entry.count)}px`}></span>
          </span>
        ),
      )}
    </div>
    <div class="mt-1 flex gap-px" aria-hidden="true">
      {series.map((entry) => (
        <span class="max-w-8 flex-1 whitespace-nowrap text-center text-[10px] leading-none text-gray-500">{axisLabel(entry.year)}</span>
      ))}
    </div>
    {missingInSeries.length > 0 && missingNote && <p class="mt-2 text-xs text-gray-500">{missingNote}</p>}
  </div>
)}
