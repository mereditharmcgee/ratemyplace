---
// The categories the city filed rows under, longest first, with a track showing each one
// against the largest. The label is the city's own word for the category, reproduced as
// stored; the bar is a count. Neither is ranked against anything outside this building.
import type { KeyBreakdown } from '../../lib/records/display';

interface Props {
  title: string;
  breakdown: KeyBreakdown;
  /** Plural noun for the leftover line, e.g. `requests`. */
  restNoun: string;
}

const { title, breakdown, restNoun } = Astro.props;

const largest = breakdown.top.length > 0 ? breakdown.top[0].count : 0;

/** Proportional to the largest category, with a floor so a single-row category still draws. */
function trackWidth(count: number): number {
  if (largest === 0) return 0;
  return Math.max(2, Math.round((count / largest) * 100));
}
---

{breakdown.top.length > 0 && (
  <div>
    <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{title}</h4>
    <ul class="mt-2 space-y-2">
      {breakdown.top.map((entry) => (
        <li class="grid grid-cols-[minmax(0,1fr)_2.5rem] items-center gap-2">
          <span class="min-w-0">
            <span class="block truncate text-xs text-gray-700" title={entry.key}>{entry.key}</span>
            <span class="mt-1 block h-1.5 w-full rounded-full bg-gray-200">
              <span class="block h-1.5 rounded-full bg-gray-700" style={`width:${trackWidth(entry.count)}%`}></span>
            </span>
          </span>
          <span class="text-right text-xs tabular-nums text-gray-600">{entry.count}</span>
        </li>
      ))}
    </ul>
    {breakdown.restTypes > 0 && (
      <p class="mt-2 text-xs text-gray-500">
        {breakdown.restTypes} more types · {breakdown.restCount} {restNoun}
      </p>
    )}
  </div>
)}
