---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-1 md:col-span-2">
        <a href="/" class="inline-flex items-center gap-3 mb-4">
          <img src="/brand/logo-mark-reverse.svg" alt="" class="h-10 w-auto" />
          <span class="font-display text-2xl text-white leading-none">RateMyPlace</span>
        </a>
        <p class="text-slate-400 max-w-md">
          A public record of rental housing, from the people who know it best.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-white uppercase tracking-[0.12em] mb-4">Quick links</h4>
        <ul class="space-y-2">
          <li><a href="/search" class="hover:text-white transition-colors">Search</a></li>
          <li><a href="/review/new" class="hover:text-white transition-colors">Write a review</a></li>
          <li><a href="/methodology" class="hover:text-white transition-colors">Scoring methodology</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/bug-report" class="hover:text-white transition-colors">Report a bug</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-white uppercase tracking-[0.12em] mb-4">Legal</h4>
        <ul class="space-y-2">
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of service</a></li>
          <li><a href="/guidelines" class="hover:text-white transition-colors">Review guidelines</a></li>
          <li><a href="/dispute" class="hover:text-white transition-colors">Dispute a review</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-700 mt-8 pt-8 text-center text-slate-400">
      <p>&copy; {currentYear} RateMyPlace. All rights reserved.</p>
      <p class="mt-2 text-sm">
        Built by <a href="https://meredithmcgee.org" target="_blank" rel="noopener noreferrer" class="text-teal-300 hover:text-teal-200 transition-colors">Meredith McGee</a>
      </p>
      <p class="mt-1 text-sm">
        Reviews reflect personal tenant experiences. Always verify information independently.
      </p>
    </div>
  </div>
</footer>
