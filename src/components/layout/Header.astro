---
import { getDB } from '../../lib/db';

const user = Astro.locals.user;

let unreadCount = 0;
if (user) {
  const db = getDB((Astro.locals as any).runtime);
  const result = await db.prepare(
    'SELECT COUNT(*) as count FROM notifications WHERE user_id = ? AND read_at IS NULL'
  ).bind(user.id).first<{ count: number }>();
  unreadCount = result?.count ?? 0;
}
---

<header class="bg-white shadow-sm border-b border-slate-200">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-2">
          <img src="/brand/logo-lockup.svg" alt="RateMyPlace" class="h-10 sm:h-12 w-auto" />
        </a>
      </div>

      <div class="hidden md:flex items-center space-x-8">
        <a href="/search" class="text-slate-600 hover:text-teal-700 transition-colors">
          Search
        </a>
        <a href="/map" class="text-slate-600 hover:text-teal-700 transition-colors">
          Map
        </a>
        <a href="/about" class="text-slate-600 hover:text-teal-700 transition-colors">
          About
        </a>
        {user ? (
          <div class="flex items-center space-x-4">
            <a
              href="/review/new"
              class="bg-teal-700 text-white font-semibold px-4 py-2 rounded-[4px] hover:bg-teal-800 transition-colors"
            >
              Write a Review
            </a>
            <a href="/profile" class="relative text-slate-600 hover:text-teal-700 transition-colors" aria-label="Notifications">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              {unreadCount > 0 && (
                <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center font-medium">
                  {unreadCount > 9 ? '9+' : unreadCount}
                </span>
              )}
            </a>
            <a href="/profile" class="text-slate-600 hover:text-teal-700 transition-colors">
              Profile
            </a>
            {user.isAdmin && (
              <a href="/admin" class="text-slate-600 hover:text-teal-700 transition-colors">
                Admin
              </a>
            )}
            <form action="/api/auth/signout" method="POST">
              <button
                type="submit"
                class="text-slate-600 hover:text-teal-700 transition-colors"
              >
                Sign Out
              </button>
            </form>
          </div>
        ) : (
          <div class="flex items-center space-x-4">
            <a href="/auth/signin" class="text-slate-600 hover:text-teal-700 transition-colors">
              Sign In
            </a>
            <a
              href="/auth/signup"
              class="bg-teal-700 text-white font-semibold px-4 py-2 rounded-[4px] hover:bg-teal-800 transition-colors"
            >
              Sign Up
            </a>
          </div>
        )}
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button
          type="button"
          class="text-slate-600 hover:text-teal-700"
          aria-label="Toggle menu"
          id="mobile-menu-button"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div class="md:hidden hidden" id="mobile-menu">
      <div class="pt-2 pb-3 space-y-1">
        <a href="/search" class="block px-3 py-2 text-slate-600 hover:bg-slate-100 rounded-md">
          Search
        </a>
        <a href="/map" class="block px-3 py-2 text-slate-600 hover:bg-slate-100 rounded-md">
          Map
        </a>
        <a href="/about" class="block px-3 py-2 text-slate-600 hover:bg-slate-100 rounded-md">
          About
        </a>
        {user ? (
          <>
            <a href="/review/new" class="block px-3 py-2 text-teal-700 hover:bg-slate-100 rounded-md">
              Write a Review
            </a>
            <a href="/profile" class="flex items-center gap-2 px-3 py-2 text-slate-600 hover:bg-slate-100 rounded-md">
              <span class="relative inline-flex">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                {unreadCount > 0 && (
                  <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center font-medium">
                    {unreadCount > 9 ? '9+' : unreadCount}
                  </span>
                )}
              </span>
              Profile {unreadCount > 0 ? `(${unreadCount > 9 ? '9+' : unreadCount})` : ''}
            </a>
            {user.isAdmin && (
              <a href="/admin" class="block px-3 py-2 text-slate-600 hover:bg-slate-100 rounded-md">
                Admin
              </a>
            )}
            <form action="/api/auth/signout" method="POST" class="px-3 py-2">
              <button type="submit" class="text-slate-600 hover:text-teal-700">
                Sign Out
              </button>
            </form>
          </>
        ) : (
          <>
            <a href="/auth/signin" class="block px-3 py-2 text-slate-600 hover:bg-slate-100 rounded-md">
              Sign In
            </a>
            <a href="/auth/signup" class="block px-3 py-2 text-teal-700 hover:bg-slate-100 rounded-md">
              Sign Up
            </a>
          </>
        )}
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
