---
// The public records panel. Product rule, non-negotiable: this panel has no opinion.
// Every value below is a field off a stored record or a count of records — no scoring,
// no score colors, no characterization of what the records mean. `display.ts` owns every
// piece of framing copy so a single test can hold the whole surface to that rule.
//
// The shape is a facts strip (what the assessor says this building is) over a ledger of four
// sources (what each city feed holds for it). A source's whole answer is a count and a span
// until the reader opens it; the lists are still there, one disclosure down. Summarizing is
// not the same as judging — a count is a count whether it reads 0 or 42, and nothing here
// sizes, colours, or orders a number by whether it is good news.
import { getBuildingRecords, type BuildingRecordsView } from '../lib/records/query';
import { logError } from '../lib/logger';
import {
  PANEL_FRAMING_COPY,
  ZERO_PERMITS_COPY,
  DECLARED_VALUATION_CAVEAT,
  OTHER_REQUESTS_COPY,
  CONDOMINIUM_COPY,
  NO_VIOLATIONS_CAVEAT,
  KIND_LABELS,
  formatDollars,
  formatDollarsCompact,
  formatPullDate,
  formatRecordDate,
  permitSummary,
  splitServiceRequests,
  rentSmartDisagreement,
  countByYear,
  countByKey,
  isOpenStatus,
  openSubCount,
  yearSpanLabel,
} from '../lib/records/display';
import { ROW_CAP } from '../lib/records/ckan';
import { FY2026_RESOURCE_ID } from '../lib/records/sources/boston/assessor';
import { PERMITS_RESOURCE_ID, PERMIT_COVERAGE_START } from '../lib/records/sources/boston/permits';
import { VIOLATIONS_RESOURCE_ID } from '../lib/records/sources/boston/violations';
import { ENFORCEMENT_RESOURCE_ID } from '../lib/records/sources/boston/enforcement';
import {
  NEW_311_RESOURCE_ID,
  HOUSING_REASONS,
  HOUSING_DEPARTMENT_PREFIX,
} from '../lib/records/sources/boston/serviceRequests';
import RecordCorrectionForm from './records/RecordCorrectionForm';
import CorrectionNotes from './records/CorrectionNotes.astro';
import FactsStrip from './records/FactsStrip.astro';
import LedgerRow from './records/LedgerRow.astro';
import YearBars from './records/YearBars.astro';
import CategoryBars from './records/CategoryBars.astro';
import StatusToken from './records/StatusToken.astro';
import type { RecordKind } from '../lib/records/types';

interface Props {
  buildingId: string;
}

const { buildingId } = Astro.props;

// The panel is one section of a building page that works without it. A read failure here —
// a D1 hiccup, a malformed row that trips the query — must not take the reviews, the score,
// and the map down with it, so the whole read is isolated and an unreadable panel renders as
// no panel at all.
let view: BuildingRecordsView | null = null;
try {
  view = await getBuildingRecords(Astro.locals.runtime.env.DB, buildingId);
} catch (error) {
  logError('building_records_panel_failed', {
    buildingId,
    error: error instanceof Error ? error.message : String(error),
  });
  view = null;
}

const current = view?.assessments[0] ?? null;
const permits = view ? permitSummary(view.permits) : null;
const requests = view ? splitServiceRequests(view.serviceRequests) : null;
const rentSmartNote = view && requests ? rentSmartDisagreement(view.rentsmart, requests.housing.length) : null;

/** null when this source has never been pulled for this building, which is not the same as empty. */
function statusFor(sourceId: string) {
  return view?.sources[sourceId] ?? null;
}

/** A source that failed its most recent attempt and left no rows behind has nothing to show. */
function unavailable(sourceId: string, kindHasRows: boolean): boolean {
  return statusFor(sourceId)?.status === 'error' && !kindHasRows;
}

/** A correction with no kind was filed against the pull as a whole, so it shows everywhere. */
function notesFor(kind: string) {
  return (view?.corrections ?? []).filter((note) => note.recordKind === kind || note.recordKind === null);
}

/**
 * The CKAN row cap is a hard slice, so a full page means there may be more upstream.
 * Counts validated rows only: a row rejected by `validatePayload` never reaches this count, so
 * a capped pull whose rows partly failed validation undercounts and the note stays off. That
 * undercount is the safe direction — the kind is already flagged as unreadable above.
 */
function capped(rowCount: number): boolean {
  return rowCount >= ROW_CAP;
}

function orNotRecorded(value: string | number | null | undefined): string {
  return value === null || value === undefined || value === '' ? 'Not recorded' : String(value);
}

/** A kind written by an older build has no label; show its stored name rather than "undefined". */
function kindLabel(kind: string): string {
  return KIND_LABELS[kind as RecordKind] ?? kind;
}

const assessorStatus = statusFor(FY2026_RESOURCE_ID);
const permitStatus = statusFor(PERMITS_RESOURCE_ID);
const violationStatus = statusFor(VIOLATIONS_RESOURCE_ID);
const enforcementStatus = statusFor(ENFORCEMENT_RESOURCE_ID);
const requestStatus = statusFor(NEW_311_RESOURCE_ID);

/**
 * Whether a row's figures mean anything yet. A source nobody has queried has no count — not a
 * zero — and neither does one whose only attempt failed, so both render `—` rather than a
 * number a reader would take as a finding.
 */
function countable(status: unknown, sourceId: string, hasRows: boolean): boolean {
  return status !== null && !unavailable(sourceId, hasRows);
}

const housing = requests?.housing ?? [];
const requestsCountable = countable(requestStatus, NEW_311_RESOURCE_ID, (view?.serviceRequests.length ?? 0) > 0);
const requestYears = countByYear(housing, (row) => row.openedAt);
const requestTypes = countByKey(housing, (row) => row.type ?? row.title, 6);
const openRequests = housing.filter((row) => isOpenStatus(row.status));

const permitsCountable = countable(permitStatus, PERMITS_RESOURCE_ID, (view?.permits.length ?? 0) > 0);
const permitYears = countByYear(view?.permits ?? [], (row) => row.issuedDate);
const permitTypes = countByKey(view?.permits ?? [], (row) => row.description ?? row.permitType ?? row.workType, 6);
const openPermits = (view?.permits ?? []).filter((row) => isOpenStatus(row.status));
const permitSubCount = permits
  ? openSubCount(openPermits.length, permits.count) +
    (permits.declaredTotal === null ? '' : ` · ${formatDollarsCompact(permits.declaredTotal)} declared`)
  : '';

const enforcementCountable = countable(enforcementStatus, ENFORCEMENT_RESOURCE_ID, (view?.enforcement.length ?? 0) > 0);
const enforcementYears = countByYear(view?.enforcement ?? [], (row) => row.statusDate);
const enforcementTypes = countByKey(view?.enforcement ?? [], (row) => row.description, 6);
const openEnforcement = (view?.enforcement ?? []).filter((row) => isOpenStatus(row.status));

const violationsCountable = countable(violationStatus, VIOLATIONS_RESOURCE_ID, (view?.violations.length ?? 0) > 0);
const violationYears = countByYear(view?.violations ?? [], (row) => row.statusDate);
const openViolations = (view?.violations ?? []).filter((row) => isOpenStatus(row.status));

// Open rows first, then everything else, each group keeping the query's date order.
const violationsOrdered = view
  ? [
      ...view.violations.filter((row) => isOpenStatus(row.status)),
      ...view.violations.filter((row) => !isOpenStatus(row.status)),
    ]
  : [];

const rowClass = 'grid grid-cols-1 sm:grid-cols-[7rem_1fr_auto] gap-x-2 gap-y-0.5 py-2';
const listClass = 'divide-y divide-gray-100 text-sm mt-2';
const bodyClass = 'text-sm text-gray-600';
const noteClass = 'text-xs text-gray-500 mt-2';
const chartsClass = 'grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5';
const disclosureClass =
  'mt-4 text-sm text-teal-700 cursor-pointer list-none [&::-webkit-details-marker]:hidden underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700';

/** A source nobody has queried has no finding to report — not an empty one, none at all. */
const NEVER_PULLED_COPY = 'Not retrieved yet.';
---

{view && (
  <section id="public-records" class="bg-white rounded-[6px] border border-gray-200 p-6 mb-8">
    <div class="flex flex-wrap items-start justify-between gap-x-4">
      <div>
        <h2 class="text-xl font-semibold text-gray-900">Public records</h2>
        <p class="mt-0.5 text-xs text-gray-500">City of Boston · pulled {formatPullDate(view.pulledAt)}</p>
      </div>
      {/* Padded to a 44px tap target rather than sized as bare text — it is the panel's one
          call to action and it sits on a phone next to a scrolling list. */}
      <a
        href="#report-record"
        class="-mr-3 inline-flex min-h-[44px] shrink-0 items-center px-3 py-2 text-sm text-teal-700 hover:underline">Report a record error</a>
    </div>
    <p class="mt-2 text-sm text-gray-600">{PANEL_FRAMING_COPY}</p>
    {view.invalidKinds.length > 0 && (
      <p class="text-xs text-amber-700 mt-2">
        Some records could not be read and are not shown ({view.invalidKinds.map(kindLabel).join(', ')}).
      </p>
    )}

    {assessorStatus === null ? (
      <p class={`${bodyClass} mt-4`}>{NEVER_PULLED_COPY}</p>
    ) : unavailable(FY2026_RESOURCE_ID, view.assessments.length > 0) ? (
      <p class={`${bodyClass} mt-4`}>Record unavailable. Last attempt {formatPullDate(assessorStatus.retrievedAt)}.</p>
    ) : current === null ? (
      <p class={`${bodyClass} mt-4`}>No assessor record on file.</p>
    ) : current.condominium ? (
      /* A condominium parcel's assessed values are the unit's, not the building's, and the
         panel does not name an owner for one — so it does not chart one either. */
      <p class={`${bodyClass} mt-4`}>{CONDOMINIUM_COPY}</p>
    ) : (
      <FactsStrip current={current} all={view.assessments} />
    )}
    <CorrectionNotes notes={notesFor('assessment')} />

    <div class="mt-6 border-b border-gray-200">
      <LedgerRow
        title="311 housing requests"
        status={requestStatus}
        hasRows={view.serviceRequests.length > 0}
        span={yearSpanLabel(requestYears)}
        note={requestsCountable && requests!.otherCount > 0
          ? `${requests!.otherCount} other request${requests!.otherCount === 1 ? '' : 's'} not shown`
          : null}
        count={requestsCountable ? String(housing.length) : '—'}
        subCount={requestsCountable ? openSubCount(openRequests.length, housing.length) : ''}
        open={true}>
        {requestStatus === null ? (
          <p class={bodyClass}>{NEVER_PULLED_COPY}</p>
        ) : unavailable(NEW_311_RESOURCE_ID, view.serviceRequests.length > 0) ? (
          <p class={bodyClass}>Record unavailable. Last attempt {formatPullDate(requestStatus.retrievedAt)}.</p>
        ) : (
          <>
            <div class={chartsClass}>
              <YearBars title="Requests by year opened" series={requestYears} noun="requests" />
              <CategoryBars title="What was reported" breakdown={requestTypes} restNoun="requests" />
            </div>
            <p class={noteClass}>
              How requests are classified: a request is housing-related when the city files it under{' '}
              {HOUSING_REASONS.join(', ')}, or routes it to {HOUSING_DEPARTMENT_PREFIX}. {OTHER_REQUESTS_COPY}
            </p>
            {openRequests.length > 0 && (
              <>
                <h4 class="mt-4 text-xs font-semibold uppercase tracking-wide text-gray-500">
                  Open now ({openRequests.length})
                </h4>
                <ul class={listClass}>
                  {openRequests.map((request) => (
                    <li class={rowClass}>
                      <span class="text-gray-500">{formatRecordDate(request.openedAt)}</span>
                      <span class="text-gray-900">{request.type ?? request.title ?? 'Request'}</span>
                      <span class="text-xs sm:text-right"><StatusToken status={request.status} /></span>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {housing.length > 0 && (
              <details>
                <summary class={disclosureClass}>Show all {housing.length} requests</summary>
                <ul class={listClass}>
                  {housing.map((request) => (
                    <li class={rowClass}>
                      <span class="text-gray-500">{formatRecordDate(request.openedAt)}</span>
                      <span class="text-gray-900">{request.type ?? request.title ?? 'Request'}</span>
                      <span class="text-xs sm:text-right">
                        <StatusToken status={request.status} />
                        {request.closedAt && <span class="text-gray-500"> · closed {formatRecordDate(request.closedAt)}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
            {capped(view.serviceRequests.length) && (
              <p class={noteClass}>First {ROW_CAP} requests considered.</p>
            )}
            {/* Only alongside the counts it disagrees with. Under "Record unavailable" or
                "Not retrieved yet" there is nothing above for it to disagree with. */}
            {rentSmartNote && <p class={noteClass}>{rentSmartNote}</p>}
          </>
        )}
        <CorrectionNotes notes={notesFor('service_request')} />
      </LedgerRow>

      <LedgerRow
        title="Building permits"
        status={permitStatus}
        hasRows={view.permits.length > 0}
        span={yearSpanLabel(permitYears)}
        count={permitsCountable ? String(permits!.count) : '—'}
        subCount={permitsCountable ? permitSubCount : ''}>
        {permitStatus === null ? (
          <p class={bodyClass}>{NEVER_PULLED_COPY}</p>
        ) : unavailable(PERMITS_RESOURCE_ID, view.permits.length > 0) ? (
          <p class={bodyClass}>Record unavailable. Last attempt {formatPullDate(permitStatus.retrievedAt)}.</p>
        ) : permits!.count === 0 ? (
          <p class={bodyClass}>{ZERO_PERMITS_COPY}</p>
        ) : (
          <>
            <div class={chartsClass}>
              <YearBars title="Permits by year issued" series={permitYears} noun="permits" />
              <CategoryBars title="Type of work" breakdown={permitTypes} restNoun="permits" />
            </div>
            <p class={noteClass}>
              On record from {PERMIT_COVERAGE_START}.{' '}
              {permits!.declaredTotal === null
                ? 'No declared valuation recorded.'
                : `Total declared valuation ${formatDollars(permits!.declaredTotal)}${
                    permits!.declaredCount < permits!.count
                      ? ` (recorded for ${permits!.declaredCount} of ${permits!.count} permits)`
                      : ''
                  }.`}{' '}
              {DECLARED_VALUATION_CAVEAT}
            </p>
            <details>
              <summary class={disclosureClass}>Show all {permits!.count} permits</summary>
              <ul class={listClass}>
                {view.permits.map((permit) => (
                  <li class={rowClass}>
                    <span class="text-gray-500">{formatRecordDate(permit.issuedDate)}</span>
                    <span class="text-gray-900">
                      {permit.permitType ?? permit.workType ?? 'Permit'}{permit.description ? ` · ${permit.description}` : ''}
                    </span>
                    <span class="text-xs sm:text-right"><StatusToken status={permit.status} /></span>
                  </li>
                ))}
              </ul>
            </details>
            {capped(view.permits.length) && <p class={noteClass}>First {ROW_CAP} shown.</p>}
          </>
        )}
        <CorrectionNotes notes={notesFor('permit')} />
      </LedgerRow>

      <LedgerRow
        title="Code enforcement tickets"
        status={enforcementStatus}
        hasRows={view.enforcement.length > 0}
        span={yearSpanLabel(enforcementYears)}
        count={enforcementCountable ? String(view.enforcement.length) : '—'}
        subCount={enforcementCountable ? openSubCount(openEnforcement.length, view.enforcement.length) : ''}>
        {enforcementStatus === null ? (
          <p class={bodyClass}>{NEVER_PULLED_COPY}</p>
        ) : unavailable(ENFORCEMENT_RESOURCE_ID, view.enforcement.length > 0) ? (
          <p class={bodyClass}>Record unavailable. Last attempt {formatPullDate(enforcementStatus.retrievedAt)}.</p>
        ) : view.enforcement.length === 0 ? (
          <p class={bodyClass}>No code enforcement tickets on record.</p>
        ) : (
          <>
            <CategoryBars title="What was ticketed" breakdown={enforcementTypes} restNoun="tickets" />
            <details>
              <summary class={disclosureClass}>Show all {view.enforcement.length} tickets</summary>
              <ul class={listClass}>
                {view.enforcement.map((ticket) => (
                  <li class={rowClass}>
                    <span class="text-gray-500">{formatRecordDate(ticket.statusDate)}</span>
                    <span class="text-gray-900">{orNotRecorded(ticket.description)}</span>
                    <span class="text-xs sm:text-right"><StatusToken status={ticket.status} /></span>
                  </li>
                ))}
              </ul>
            </details>
            {capped(view.enforcement.length) && <p class={noteClass}>First {ROW_CAP} shown.</p>}
          </>
        )}
        <CorrectionNotes notes={notesFor('enforcement_ticket')} />
      </LedgerRow>

      <LedgerRow
        title="ISD violations"
        status={violationStatus}
        hasRows={view.violations.length > 0}
        span={yearSpanLabel(violationYears)}
        count={violationsCountable ? String(view.violations.length) : '—'}
        subCount={violationsCountable ? openSubCount(openViolations.length, view.violations.length) : ''}>
        {violationStatus === null ? (
          <p class={bodyClass}>{NEVER_PULLED_COPY}</p>
        ) : unavailable(VIOLATIONS_RESOURCE_ID, view.violations.length > 0) ? (
          <p class={bodyClass}>Record unavailable. Last attempt {formatPullDate(violationStatus.retrievedAt)}.</p>
        ) : view.violations.length === 0 ? (
          <>
            <p class={bodyClass}>No violations on record.</p>
            <p class={noteClass}>{NO_VIOLATIONS_CAVEAT}</p>
          </>
        ) : (
          <>
            <ul class={listClass}>
              {violationsOrdered.map((violation) => (
                <li class={rowClass}>
                  <span class="text-gray-500">{formatRecordDate(violation.statusDate)}</span>
                  <span class="text-gray-900">
                    {[violation.code, violation.description].filter(Boolean).join(' · ') || 'Violation'}
                  </span>
                  <span class="text-xs sm:text-right"><StatusToken status={violation.status} /></span>
                </li>
              ))}
            </ul>
            {capped(view.violations.length) && <p class={noteClass}>First {ROW_CAP} shown.</p>}
          </>
        )}
        <CorrectionNotes notes={notesFor('violation')} />
      </LedgerRow>
    </div>

    <div id="report-record" class="border-t border-gray-200 pt-4 mt-6">
      <h3 class="text-base font-semibold text-gray-900">Report a record error</h3>
      <p class="text-sm text-gray-600 mt-1">
        If a record above does not match the city's own data, tell us which one. We re-pull it from the primary
        source. We never edit a value by hand.
      </p>
      <div class="mt-2">
        <RecordCorrectionForm client:load buildingId={buildingId} />
      </div>
    </div>
  </section>
)}

{/* The correction form is the only Turnstile widget on a building page, and it only exists
    inside the panel above — so the script loads with the panel rather than on every building
    page. A building with no pulls renders neither, and pays for neither. */}
{view && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}
