---
// The public records panel. Product rule, non-negotiable: this panel has no opinion.
// Every value below is a field off a stored record or a count of records — no scoring,
// no score colors, no characterization of what the records mean. `display.ts` owns every
// piece of framing copy so a single test can hold the whole surface to that rule.
//
// The shape is a facts strip (what the assessor says this building is) over a ledger of the
// city feeds in three groups (living conditions, building safety and code, property upkeep).
// A source's whole answer is a count and a span until the reader opens it; the lists are
// still there, one disclosure down. Summarizing is
// not the same as judging — a count is a count whether it reads 0 or 42, and nothing here
// sizes or colours a number by whether it is good news. Open rows are listed before closed
// ones, which orders the list by the city's own status word: a fact about the record, on the
// same footing as its date, and not a claim that an open record is the worse one.
//
// The derivation behind the rows lives in `lib/records/ledger.ts`. This file is markup.
import { getBuildingRecords, type BuildingRecordsView } from '../lib/records/query';
import { logError } from '../lib/logger';
import {
  PANEL_FRAMING_COPY,
  ZERO_PERMITS_COPY,
  DECLARED_VALUATION_CAVEAT,
  GROUPING_NOTE,
  GROUPING_LINK_TEXT,
  CONDOMINIUM_COPY,
  NO_VIOLATIONS_CAVEAT,
  KIND_LABELS,
  REQUESTED_COPY,
  REQUEST_PARKED_COPY,
  formatDollars,
  formatPullDate,
} from '../lib/records/display';
import { ledgerModel } from '../lib/records/ledger';
import { recordsRequestState, type RecordsRequestState } from '../lib/records/coverage';
import { FY2026_RESOURCE_ID } from '../lib/records/sources/boston/assessor';
import { PERMIT_COVERAGE_START } from '../lib/records/sources/boston/permits';
import { RECORD_GROUPS, type RecordGroup, type RecordGroupId } from '../lib/records/recordGroups';
import RecordCorrectionForm from './records/RecordCorrectionForm';
import RecordsRequestButton from './records/RecordsRequestButton';
import CorrectionNotes from './records/CorrectionNotes.astro';
import FactsStrip from './records/FactsStrip.astro';
import LedgerRow from './records/LedgerRow.astro';
import CaseList from './records/CaseList.astro';
import RecordList from './records/RecordList.astro';
import RequestsBody from './records/RequestsBody.astro';
import SourceState from './records/SourceState.astro';
import YearBars from './records/YearBars.astro';
import CategoryBars from './records/CategoryBars.astro';
import type { RecordKind } from '../lib/records/types';

interface Props {
  buildingId: string;
}

const { buildingId } = Astro.props;

// The panel is one section of a building page that works without it. A read failure here —
// a D1 hiccup, a malformed row that trips the query — must not take the reviews, the score,
// and the map down with it, so the whole read is isolated and an unreadable panel renders as
// no panel at all.
let view: BuildingRecordsView | null = null;
// Only asked when there is a panel to put the button in, and isolated separately from the
// panel read: a queue or coverage read that fails costs the page nothing but the button,
// where sharing the panel's try/catch would have cost it the whole panel.
let requestState: RecordsRequestState = 'ineligible';
try {
  view = await getBuildingRecords(Astro.locals.runtime.env.DB, buildingId);
} catch (error) {
  logError('building_records_panel_failed', {
    buildingId,
    error: error instanceof Error ? error.message : String(error),
  });
  view = null;
}
if (view) {
  try {
    requestState = await recordsRequestState(Astro.locals.runtime.env.DB, buildingId);
  } catch (error) {
    logError('records_request_state_failed', {
      buildingId,
      error: error instanceof Error ? error.message : String(error),
    });
    requestState = 'ineligible';
  }
}

const current = view?.assessments[0] ?? null;
const assessorStatus = view?.sources[FY2026_RESOURCE_ID] ?? null;
const ledger = view ? ledgerModel(view, new Date()) : null;

/** A correction with no kind was filed against the pull as a whole, so it shows everywhere. */
function notesFor(kind: string) {
  return (view?.corrections ?? []).filter((note) => note.recordKind === kind || note.recordKind === null);
}

/** A kind written by an older build has no label; show its stored name rather than "undefined". */
function kindLabel(kind: string): string {
  return KIND_LABELS[kind as RecordKind] ?? kind;
}

/** The three groups by id, so the template can place each one's heading by name. */
const groups = Object.fromEntries(RECORD_GROUPS.map((group) => [group.id, group])) as Record<RecordGroupId, RecordGroup>;
/** The methodology section that lists every 311 type in each group, from the same table. */
const GROUPING_LINK_HREF = '/methodology#public-records-are-not-scored';

const groupHeadingClass = 'text-lg font-semibold text-gray-900';
const groupDescriptionClass = 'mt-0.5 text-xs text-gray-500';
const bodyClass = 'text-sm text-gray-600';
const noteClass = 'text-xs text-gray-500 mt-2';
const chartsClass = 'grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5';
const disclosureClass =
  'mt-4 text-sm text-teal-700 cursor-pointer list-none [&::-webkit-details-marker]:hidden underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700';
---

{view && ledger && (
  <section id="public-records" class="bg-white rounded-[6px] border border-gray-200 p-6 mb-8">
    <div class="flex flex-wrap items-start justify-between gap-x-4">
      <div>
        <h2 class="text-xl font-semibold text-gray-900">Public records</h2>
        <p class="mt-0.5 text-xs text-gray-500">City of Boston · pulled {formatPullDate(view.pulledAt)}</p>
      </div>
      {/* Padded to a 44px tap target rather than sized as bare text — it is the panel's one
          call to action and it sits on a phone next to a scrolling list. */}
      <a
        href="#report-record"
        class="-mx-3 inline-flex min-h-[44px] shrink-0 items-center px-3 py-2 text-sm text-teal-700 hover:underline">Report a record error</a>
    </div>
    <p class="mt-2 text-sm text-gray-600">{PANEL_FRAMING_COPY}</p>
    {view.invalidKinds.length > 0 && (
      <p class="text-xs text-amber-700 mt-2">
        Some records could not be read and are not shown ({view.invalidKinds.map(kindLabel).join(', ')}).
      </p>
    )}

    <div class="mt-4">
      <SourceState status={assessorStatus} hasRows={view.assessments.length > 0}>
        {current === null ? (
          <p class={bodyClass}>No assessor record on file.</p>
        ) : current.condominium ? (
          /* A condominium parcel's assessed values are the unit's, not the building's, and the
             panel does not name an owner for one — so it does not chart one either. */
          <p class={bodyClass}>{CONDOMINIUM_COPY}</p>
        ) : (
          <FactsStrip current={current} all={view.assessments} />
        )}
      </SourceState>
    </div>
    <CorrectionNotes notes={notesFor('assessment')} />

    {requestState === 'requested' && (
      <p class="mt-4 text-sm text-gray-600" role="status">{REQUESTED_COPY}</p>
    )}
    {requestState === 'parked' && (
      <p class="mt-4 text-sm text-gray-600" role="status">{REQUEST_PARKED_COPY}</p>
    )}
    {(requestState === 'never_pulled' || requestState === 'fill_queued') && (
      <div class="mt-4 border-t border-gray-200 pt-4">
        <RecordsRequestButton client:load buildingId={buildingId} initialState={requestState} />
      </div>
    )}

    {/* Three groups, in the order the owner set: living conditions, then building safety and
        code, then property upkeep. The order follows what a renter came to ask about; it is not
        a ranking of the records, and nothing in a group is scored. Which group a 311 request is
        in comes from the request type the city recorded (`lib/records/recordGroups.ts`). */}
    <section aria-labelledby="records-group-living" class="mt-6">
      <h3 id="records-group-living" class={groupHeadingClass}>{groups.living.title}</h3>
      <p class={groupDescriptionClass}>{groups.living.description}</p>
      <div class="mt-2 border-b border-gray-200">
        <LedgerRow
          title="311 living conditions requests"
          status={ledger.living.status}
          hasRows={ledger.living.hasRows}
          span={ledger.living.span}
          count={ledger.living.count}
          subCount={ledger.living.subCount}
          open={true}>
          <SourceState status={ledger.living.status} hasRows={ledger.living.hasRows}>
            <RequestsBody section={ledger.living} emptyCopy="No living conditions requests on record." />
          </SourceState>
        </LedgerRow>
      </div>
    </section>

    <section aria-labelledby="records-group-building" class="mt-6">
      <h3 id="records-group-building" class={groupHeadingClass}>{groups.building.title}</h3>
      <p class={groupDescriptionClass}>{groups.building.description}</p>
      <div class="mt-2 border-b border-gray-200">
        <LedgerRow
          title="ISD violation cases"
          status={ledger.violations.status}
          hasRows={ledger.violations.hasRows}
          span={ledger.violations.span}
          note={ledger.violations.note}
          count={ledger.violations.count}
          subCount={ledger.violations.subCount}>
          <SourceState status={ledger.violations.status} hasRows={ledger.violations.hasRows}>
            {ledger.violations.cases.length === 0 ? (
              <>
                <p class={bodyClass}>No violations on record.</p>
                <p class={noteClass}>{NO_VIOLATIONS_CAVEAT}</p>
              </>
            ) : (
              <>
                {ledger.violations.openNote && <p class={noteClass}>{ledger.violations.openNote}</p>}
                <CaseList cases={ledger.violations.cases} cappedNote={ledger.violations.cappedNote} />
              </>
            )}
          </SourceState>
        </LedgerRow>
        <CorrectionNotes notes={notesFor('violation')} />

        <LedgerRow
          title="311 building and code requests"
          status={ledger.buildingRequests.status}
          hasRows={ledger.buildingRequests.hasRows}
          span={ledger.buildingRequests.span}
          count={ledger.buildingRequests.count}
          subCount={ledger.buildingRequests.subCount}>
          <SourceState status={ledger.buildingRequests.status} hasRows={ledger.buildingRequests.hasRows}>
            <RequestsBody section={ledger.buildingRequests} emptyCopy="No building and code requests on record." />
          </SourceState>
        </LedgerRow>

        <LedgerRow
          title="Building permits"
          status={ledger.permits.status}
          hasRows={ledger.permits.hasRows}
          span={ledger.permits.span}
          count={ledger.permits.count}
          subCount={ledger.permits.subCount}>
          <SourceState status={ledger.permits.status} hasRows={ledger.permits.hasRows}>
            {ledger.permits.summary.count === 0 ? (
              <p class={bodyClass}>{ZERO_PERMITS_COPY}</p>
            ) : (
              <>
                <div class={chartsClass}>
                  <YearBars title="Permits by year issued" series={ledger.permits.years} noun="permits" />
                  <CategoryBars title="Type of work" breakdown={ledger.permits.types} noun={{ one: 'permit', many: 'permits' }} />
                </div>
                <p class={noteClass}>
                  On record from {PERMIT_COVERAGE_START}.{' '}
                  {ledger.permits.summary.declaredTotal === null
                    ? 'No declared valuation recorded.'
                    : `Total declared valuation ${formatDollars(ledger.permits.summary.declaredTotal)}${
                        ledger.permits.summary.declaredCount < ledger.permits.summary.count
                          ? ` (recorded for ${ledger.permits.summary.declaredCount} of ${ledger.permits.summary.count} permits)`
                          : ''
                      }.`}{' '}
                  {DECLARED_VALUATION_CAVEAT}
                </p>
                <details>
                  <summary class={disclosureClass}>{ledger.permits.showAll}</summary>
                  <RecordList rows={ledger.permits.rows} cappedNote={ledger.permits.cappedNote} />
                </details>
              </>
            )}
          </SourceState>
        </LedgerRow>
        <CorrectionNotes notes={notesFor('permit')} />
      </div>
    </section>

    <section aria-labelledby="records-group-upkeep" class="mt-6">
      <h3 id="records-group-upkeep" class={groupHeadingClass}>{groups.upkeep.title}</h3>
      <p class={groupDescriptionClass}>{groups.upkeep.description}</p>
      <div class="mt-2 border-b border-gray-200">
        <LedgerRow
          title="Public Works code enforcement tickets"
          status={ledger.enforcement.status}
          hasRows={ledger.enforcement.hasRows}
          span={ledger.enforcement.span}
          note={ledger.enforcement.note}
          count={ledger.enforcement.count}
          subCount={ledger.enforcement.subCount}>
          <SourceState status={ledger.enforcement.status} hasRows={ledger.enforcement.hasRows}>
            {ledger.enforcement.cases.length === 0 ? (
              <p class={bodyClass}>No code enforcement tickets on record.</p>
            ) : (
              <>
                <CategoryBars
                  title="What was ticketed"
                  breakdown={ledger.enforcement.types}
                  noun={{ one: 'violation line', many: 'violation lines' }}
                />
                <details>
                  <summary class={disclosureClass}>{ledger.enforcement.showAll}</summary>
                  {ledger.enforcement.openNote && <p class={noteClass}>{ledger.enforcement.openNote}</p>}
                  <CaseList cases={ledger.enforcement.cases} cappedNote={ledger.enforcement.cappedNote} />
                </details>
              </>
            )}
          </SourceState>
        </LedgerRow>
        <CorrectionNotes notes={notesFor('enforcement_ticket')} />

        <LedgerRow
          title="311 property upkeep requests"
          status={ledger.upkeepRequests.status}
          hasRows={ledger.upkeepRequests.hasRows}
          span={ledger.upkeepRequests.span}
          count={ledger.upkeepRequests.count}
          subCount={ledger.upkeepRequests.subCount}>
          <SourceState status={ledger.upkeepRequests.status} hasRows={ledger.upkeepRequests.hasRows}>
            <RequestsBody section={ledger.upkeepRequests} emptyCopy="No property upkeep requests on record." />
          </SourceState>
        </LedgerRow>
      </div>
    </section>

    {/* What the three groups leave out, said once for all three 311 rows: how a request is
        placed, how many fit none of the groups, and the RentSmart cross-check. A correction
        filed against 311 sits here too, outside every disclosure, so a reader who opens no row
        still sees it. */}
    <div class="mt-4">
      <p class={noteClass}>
        {GROUPING_NOTE}{' '}
        <a href={GROUPING_LINK_HREF} class="text-teal-700 underline underline-offset-2">{GROUPING_LINK_TEXT}</a>
      </p>
      {ledger.other.line && <p class={noteClass}>{ledger.other.line}</p>}
      {ledger.other.rentSmartNote && <p class={noteClass}>{ledger.other.rentSmartNote}</p>}
      <CorrectionNotes notes={notesFor('service_request')} />
    </div>

    {/* Folded by default: most readers never report an error, and an open form (with its
        Turnstile) made the panel's last screen a form. The header link, a #report-record URL,
        and a hash change all unfold it (script below). `client:visible` means the island
        hydrates, and renders its Turnstile, only once the unfolded form is on screen. */}
    <details id="report-record" class="group border-t border-gray-200 pt-4 mt-6">
      <summary
        class="flex items-center justify-between gap-3 min-h-[44px] cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-[4px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">
        <h3 class="text-base font-semibold text-gray-900">Report a record error</h3>
        <svg
          class="h-4 w-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180 motion-reduce:transition-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true">
          <path d="M5 7.5 10 12.5 15 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </summary>
      <p class="text-sm text-gray-600 mt-1">
        If a record above does not match the city's own data, tell us which one. We re-pull it from the primary
        source. We never edit a value by hand.
      </p>
      <div class="mt-2">
        <RecordCorrectionForm client:visible buildingId={buildingId} />
      </div>
    </details>
  </section>
)}

{/* Both Turnstile widgets on a building page live inside the panel above — the correction
    form renders one when a reader unfolds it, the records button renders one on press — so
    the script loads with the panel rather than on every building page. A building with no
    pulls renders neither, and pays for neither. */}
{view && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  // Unfold the record-error form when a reader asks for it: the header link, a shared
  // #report-record URL, or a hash change. Opening it on the link's click (not only on
  // hashchange) covers a second click when the hash is already #report-record.
  const REPORT_HASH = '#report-record';

  function unfoldReportForm(): void {
    const report = document.getElementById('report-record');
    if (report instanceof HTMLDetailsElement) report.open = true;
  }

  if (location.hash === REPORT_HASH) unfoldReportForm();
  window.addEventListener('hashchange', () => {
    if (location.hash === REPORT_HASH) unfoldReportForm();
  });
  document.querySelectorAll(`a[href="${REPORT_HASH}"]`).forEach((link) => {
    link.addEventListener('click', unfoldReportForm);
  });
</script>
