---
/**
 * Blue "Verified" badge for a review whose tenant proved residency with a document.
 *
 * The explanation is anchored to the nearest positioned ancestor, not to the badge, so
 * put `relative` on the row the badge sits in. The tooltip starts at that row's left
 * edge and is never wider than the row. A tooltip centered on the badge with unwrapped
 * text stuck out past the card and made phone pages scroll sideways, even while hidden.
 *
 * The badge takes keyboard focus so the explanation shows on focus as well as hover.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
}

const { size = 'md', showText = true } = Astro.props;

const sizeClasses = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

const textSizeClasses = {
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
};
---

<span
  class="inline-flex items-center gap-1 text-blue-600 group cursor-help rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
  tabindex="0"
>
  <svg
    class={sizeClasses[size]}
    fill="currentColor"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
      clip-rule="evenodd"
    />
  </svg>
  {showText && <span class={`font-medium ${textSizeClasses[size]}`}>Verified</span>}
  <span
    class="absolute bottom-full left-0 mb-2 w-max max-w-[min(16rem,100%)] whitespace-normal text-left px-3 py-2 bg-gray-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity pointer-events-none z-10"
    data-verified-tooltip
  >
    This tenant verified their residency with a lease or similar document
  </span>
</span>
