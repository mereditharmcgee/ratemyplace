---
/**
 * Blue "Residency verified" badge for a review whose tenant proved residency with a
 * document (`is_verified = 1`). The label names what was checked: the upload accepts a
 * lease, a utility bill, a rent receipt or mail, so it says residency rather than lease.
 * It stays on one line and does not shrink, so a long review title wraps instead.
 *
 * The explanation is anchored to the nearest positioned ancestor, not to the badge, so
 * put `relative` on the row the badge sits in. The tooltip starts at that row's left
 * edge and is never wider than the row. A tooltip centered on the badge with unwrapped
 * text stuck out past the card and made phone pages scroll sideways, even while hidden.
 *
 * The badge takes keyboard focus so the explanation shows on focus as well as hover.
 * The explanation is the badge's tooltip (role="tooltip", tied by aria-describedby), and
 * Escape hides it until the badge loses focus or the pointer leaves (WCAG 1.4.13).
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
}

const { size = 'md', showText = true } = Astro.props;

// One per badge: a page lists many reviews.
const tipId = `verified-tip-${crypto.randomUUID().slice(0, 8)}`;

const sizeClasses = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

const textSizeClasses = {
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
};
---

<span
  class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap text-blue-600 group cursor-help rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
  tabindex="0"
  aria-describedby={tipId}
  data-verified-badge
>
  <svg
    class={sizeClasses[size]}
    fill="currentColor"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
      clip-rule="evenodd"
    />
  </svg>
  {showText && <span class={`font-medium ${textSizeClasses[size]}`}>Residency verified</span>}
  <span
    id={tipId}
    role="tooltip"
    class="absolute bottom-full left-0 mb-2 w-max max-w-[min(16rem,100%)] whitespace-normal text-left px-3 py-2 bg-gray-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 group-focus:opacity-100 group-data-[dismissed]:opacity-0! transition-opacity pointer-events-none z-10"
    data-verified-tooltip
  >
    This tenant verified their residency with a lease or similar document
  </span>
</span>

<script>
  // Escape hides the explanation of a focused or hovered badge; it comes back once the
  // badge loses focus or the pointer leaves it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const badge of document.querySelectorAll<HTMLElement>('[data-verified-badge]')) {
      if (badge === document.activeElement || badge.matches(':hover')) badge.setAttribute('data-dismissed', '');
    }
  });
  document.addEventListener('focusout', (event) => {
    const badge = event.target;
    if (badge instanceof HTMLElement && badge.matches('[data-verified-badge]')) badge.removeAttribute('data-dismissed');
  });
  // mouseleave does not bubble, so listen in the capture phase.
  document.addEventListener(
    'mouseleave',
    (event) => {
      const badge = event.target;
      if (badge instanceof HTMLElement && badge.matches('[data-verified-badge]') && badge !== document.activeElement) {
        badge.removeAttribute('data-dismissed');
      }
    },
    true,
  );
</script>
