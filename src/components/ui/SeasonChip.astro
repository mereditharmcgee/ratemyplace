---
import { formatTenancyRange } from '../../lib/privacy';

interface Props {
  moveInSeason?: string | null;
  moveInYear?: number | string | null;
  moveOutSeason?: string | null;
  moveOutYear?: number | string | null;
  isCurrentTenant?: boolean;
  class?: string;
}

const {
  moveInSeason,
  moveInYear,
  moveOutSeason,
  moveOutYear,
  isCurrentTenant = false,
  class: className = '',
} = Astro.props;

// The range logic (and the rule that it never runs backwards) lives in privacy.ts.
const display = formatTenancyRange({ moveInSeason, moveInYear, moveOutSeason, moveOutYear, isCurrentTenant });
---

{display && (
  <span class:list={[
    'inline-block border border-slate-900 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-900 rounded-[2px]',
    className,
  ]}>
    {display}
  </span>
)}
