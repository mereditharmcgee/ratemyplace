---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { ContactForm } from '../components/contact/ContactForm';
---

<BaseLayout title="Contact Us" description="Have a question, concern, or feedback? Get in touch with the RateMyPlace Boston team.">
  <div class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Contact Us</h1>
    <p class="text-gray-600 mb-8">
      Have a question, concern, or feedback? We'd love to hear from you.
    </p>

    <div class="bg-teal-50 rounded-lg border border-teal-200 p-4 mb-6">
      <p class="text-sm text-gray-700">
        You can also email us directly at <a href="mailto:contact@ratemyplace.org" class="text-teal-600 font-medium hover:underline">contact@ratemyplace.org</a> or <a href="mailto:landlords@ratemyplace.org" class="text-teal-600 font-medium hover:underline">landlords@ratemyplace.org</a> for landlord/property manager inquiries.
      </p>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
      <ContactForm client:load />
    </div>

    <p class="text-sm text-gray-500 mt-6 text-center">
      Reporting a bug? Use our dedicated <a href="/bug-report" class="text-teal-600 hover:underline">bug report form</a>.
    </p>
  </div>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
