---
import BaseLayout from '../components/layout/BaseLayout.astro';
import HomeSearch from '../components/HomeSearch';
---

<BaseLayout title="Home" description="Find honest tenant reviews for apartments and landlords. Real experiences from real renters to help you make informed rental decisions.">
  <div class="bg-gradient-to-b from-slate-800 to-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center">
        <h1 class="font-display text-5xl sm:text-6xl md:text-7xl font-normal tracking-tight leading-[1.05] mb-6">
          Know before <em class="italic">you</em> sign.
        </h1>
        <p class="text-xl text-slate-300 mb-8 max-w-2xl mx-auto">
          A public record of rental housing, from the people who know it best. Verified reviews, evidence-based scoring.
        </p>

        <HomeSearch client:load />

        <a
          href="/review/new"
          class="inline-block mt-6 border border-white text-white font-semibold rounded-[4px] px-5 py-2.5 hover:bg-white hover:text-slate-900 transition-colors"
        >
          Write a review
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-teal-700 text-center mb-3">Three steps</p>
    <h2 class="text-2xl font-bold text-gray-900 text-center mb-12">How it works</h2>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Search</h3>
        <p class="text-gray-600">
          Search by address, neighborhood, or landlord. See what tenants who lived there have written.
        </p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Read reviews</h3>
        <p class="text-gray-600">
          Read what tenants reported about conditions, management, and the issues research shows actually affect health.
        </p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Write a review</h3>
        <p class="text-gray-600">
          Write a review. The next tenant will read it.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-teal-700 mb-3">Evidence, not vibes</p>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Why this record is trustworthy</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Verified reviewers, anonymous reviews, methodology you can read.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-[6px] border border-slate-200 hover:shadow-sm transition-shadow">
          <h3 class="font-semibold text-gray-900 mb-2">Verified tenants</h3>
          <p class="text-sm text-gray-600">
            Reviewers create an account and confirm they lived at the property before posting.
          </p>
        </div>

        <div class="bg-white p-6 rounded-[6px] border border-slate-200 hover:shadow-sm transition-shadow">
          <h3 class="font-semibold text-gray-900 mb-2">Privacy protected</h3>
          <p class="text-sm text-gray-600">
            Move dates display as seasons, not exact dates. Reviewers stay anonymous.
          </p>
        </div>

        <div class="bg-white p-6 rounded-[6px] border border-slate-200 hover:shadow-sm transition-shadow">
          <h3 class="font-semibold text-gray-900 mb-2">Moderated content</h3>
          <p class="text-sm text-gray-600">
            Reviews are checked for guideline compliance before publishing.
          </p>
        </div>

        <div class="bg-white p-6 rounded-[6px] border border-slate-200 hover:shadow-sm transition-shadow">
          <h3 class="font-semibold text-gray-900 mb-2">Evidence-based scoring</h3>
          <p class="text-sm text-gray-600">
            Scores are weighted by peer-reviewed housing health research. The methodology is documented.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-teal-700 mb-3">The next tenant will read it</p>
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Add to the record</h2>
    <p class="text-gray-600 mb-8">
      Your review helps the next tenant. The record gets stronger every time someone contributes.
    </p>
    <a
      href="/review/new"
      class="inline-block bg-teal-700 text-white px-8 py-3 rounded-[4px] font-semibold hover:bg-teal-800 transition-colors"
    >
      Write a review
    </a>
  </div>
</BaseLayout>
