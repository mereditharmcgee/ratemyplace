---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import DisputesQueue from '../../components/admin/DisputesQueue';

const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/auth/signin');
}

// Redirect if not admin
if (!user.isAdmin) {
  return Astro.redirect('/');
}
---

<AdminLayout title="Disputes" currentPage="disputes">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Disputes</h1>
      <p class="text-gray-600 mt-1">Review and resolve landlord disputes.</p>
    </div>

    <DisputesQueue client:load />
  </div>
</AdminLayout>
