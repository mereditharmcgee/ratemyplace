---
import AdminLayout from '../../components/admin/AdminLayout.astro';

const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/auth/signin');
}

// Redirect if not admin
if (!user.isAdmin) {
  return Astro.redirect('/');
}

const db = Astro.locals.runtime.env.DB;
const { results: messages } = await db.prepare(
  'SELECT * FROM contact_messages ORDER BY created_at DESC LIMIT 100'
).all<{
  id: string;
  name: string;
  email: string;
  category: string;
  message: string;
  status: string;
  created_at: number;
  resolved_at: number | null;
  admin_notes: string | null;
}>();

const categoryColors: Record<string, string> = {
  general: 'bg-blue-100 text-blue-800',
  privacy: 'bg-purple-100 text-purple-800',
  support: 'bg-amber-100 text-amber-800',
  landlord: 'bg-teal-100 text-teal-800',
};

const categoryLabels: Record<string, string> = {
  general: 'General',
  privacy: 'Privacy',
  support: 'Support',
  landlord: 'Landlord',
};

function formatDate(unixTs: number): string {
  return new Date(unixTs * 1000).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<AdminLayout title="Contact Messages" currentPage="contact">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Contact Messages</h1>
      <p class="text-gray-600 mt-1">Messages submitted via the contact form.</p>
    </div>

    {messages.length === 0 ? (
      <div class="bg-white rounded-[6px] border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <p class="text-gray-500">No contact messages yet.</p>
      </div>
    ) : (
      <div class="bg-white rounded-[6px] border border-gray-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Message</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              {messages.map((msg) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    {formatDate(msg.created_at)}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    {msg.name}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                    <a href={`mailto:${msg.email}`} class="text-teal-700 hover:underline">
                      {msg.email}
                    </a>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${categoryColors[msg.category] || 'bg-gray-100 text-gray-800'}`}>
                      {categoryLabels[msg.category] || msg.category}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-700 max-w-xs">
                    <span class="line-clamp-2" title={msg.message}>
                      {msg.message.length > 120 ? msg.message.slice(0, 120) + '...' : msg.message}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                      msg.status === 'resolved'
                        ? 'bg-green-100 text-green-800'
                        : 'bg-blue-100 text-blue-800'
                    }`}>
                      {msg.status === 'resolved' ? 'Resolved' : 'New'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="px-6 py-3 bg-gray-50 border-t border-gray-200 text-sm text-gray-500">
          Showing {messages.length} message{messages.length !== 1 ? 's' : ''}
        </div>
      </div>
    )}
  </div>
</AdminLayout>
