---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import BugReportsTable from '../../components/admin/BugReportsTable';

const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/auth/signin');
}

// Redirect if not admin
if (!user.isAdmin) {
  return Astro.redirect('/');
}
---

<AdminLayout title="Bug Reports" currentPage="bugs">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Bug Reports</h1>
      <p class="text-gray-600 mt-1">View and manage user-submitted bug reports.</p>
    </div>

    <BugReportsTable client:load />
  </div>
</AdminLayout>
