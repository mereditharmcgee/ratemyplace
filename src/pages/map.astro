---
import BaseLayout from '../components/layout/BaseLayout.astro';
import BuildingMap from '../components/BuildingMap';
import { getScoreHex, getScoreColor } from '../lib/scoring-colors';

const apiKey = Astro.locals.runtime.env.GOOGLE_MAPS_API_KEY || '';

// Score-band explainer cards. Color + label come from the canonical
// scoring-colors source so they match the map markers (all four bands).
const scoreBands = [
  { score: 4.5, range: '4–5', blurb: 'Highly rated by tenants', detail: 'Positive experiences reported. Most tenants would recommend.' },
  { score: 3.5, range: '3–3.9', blurb: 'Average ratings', detail: 'A mix of positive and negative feedback. Check specific reviews for details.' },
  { score: 2.5, range: '2–2.9', blurb: 'Issues reported', detail: 'Notable concerns raised by tenants. Review carefully before renting.' },
  { score: 1.5, range: '1–1.9', blurb: 'Serious problems', detail: 'Significant problems reported by tenants across multiple reviews.' },
];
---

<BaseLayout title="Map" description="Explore rental buildings on an interactive map. Find apartments with color-coded scores from tenant reviews.">
  <div class="bg-paper min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Explore Buildings</h1>
        <p class="text-gray-600 mt-2">
          Browse apartments on the map. Colors indicate tenant review scores.
        </p>
      </div>

      {apiKey ? (
        <BuildingMap client:load apiKey={apiKey} />
      ) : (
        <div class="w-full h-[500px] bg-gray-100 rounded-[6px] flex items-center justify-center">
          <div class="text-center text-gray-600">
            <svg class="w-12 h-12 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            <p class="font-medium">Map not available</p>
            <p class="text-sm">Map temporarily unavailable</p>
          </div>
        </div>
      )}

      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {scoreBands.map((band) => (
          <div class="bg-white p-6 rounded-[6px] border border-slate-200 hover:shadow-sm transition-shadow">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center" style={`background: ${getScoreHex(band.score)}20;`}>
                <div class="w-4 h-4 rounded-full" style={`background: ${getScoreHex(band.score)};`}></div>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">{getScoreColor(band.score).label} ({band.range})</h3>
                <p class="text-sm text-gray-600">{band.blurb}</p>
              </div>
            </div>
            <p class="text-sm text-gray-500">{band.detail}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <p class="text-gray-600 mb-4">
          Don't see your building? Help other renters by adding a review.
        </p>
        <a
          href="/review/new"
          class="inline-block bg-teal-700 text-white px-6 py-2 rounded-[4px] font-semibold hover:bg-teal-800 transition-colors"
        >
          Write a Review
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
