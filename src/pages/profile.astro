---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ProfileDashboard from '../components/profile/ProfileDashboard';
import { getDB } from '../lib/db';

const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/auth/signin?redirect=/profile');
}

// Get user profile data from database
const db = getDB((Astro.locals as any).runtime);
const dbUser = await db.prepare(
  'SELECT created_at, email_verified, hashed_password, google_id, notification_opt_in FROM users WHERE id = ?'
)
  .bind(user.id)
  .first<{
    created_at: number;
    email_verified: number;
    hashed_password: string | null;
    google_id: string | null;
    notification_opt_in: number;
  }>();

// Format member since date
const memberSince = dbUser
  ? new Date(dbUser.created_at * 1000).toLocaleDateString('en-US', {
      month: 'long',
      year: 'numeric'
    })
  : 'Unknown';

// Get email verification status
const emailVerified = dbUser ? Boolean(dbUser.email_verified) : false;

// Compute settings-related props
const hasPassword = !!dbUser?.hashed_password;
const isGoogleUser = !!dbUser?.google_id;
const notificationOptIn = dbUser?.notification_opt_in !== 0;

// Get unread notification count
const unreadResult = await db.prepare(
  'SELECT COUNT(*) as count FROM notifications WHERE user_id = ? AND read_at IS NULL'
).bind(user.id).first<{ count: number }>();
const unreadNotificationCount = unreadResult?.count ?? 0;

const updated = Astro.url.searchParams.get('updated') === 'true';
---

<BaseLayout title="My Profile" description="Manage your reviews and profile on RateMyPlace.">
  {updated && (
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <div class="bg-teal-50 border border-teal-200 rounded-lg p-4 flex items-start gap-3" id="updated-banner">
        <svg class="w-5 h-5 text-teal-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-teal-800 font-medium flex-1">Your review has been updated.</p>
        <button onclick="document.getElementById('updated-banner').remove()" class="text-teal-400 hover:text-teal-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  )}
  <ProfileDashboard
    client:load
    userEmail={user.email}
    userName={user.name}
    avatarUrl={user.avatarUrl}
    memberSince={memberSince}
    emailVerified={emailVerified}
    unreadNotificationCount={unreadNotificationCount}
    hasPassword={hasPassword}
    isGoogleUser={isGoogleUser}
    notificationOptIn={notificationOptIn}
  />
</BaseLayout>
