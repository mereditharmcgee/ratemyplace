---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import StarRating from '../../components/ratings/StarRating.astro';
import ReviewCard from '../../components/reviews/ReviewCard.astro';
import ScoreCard from '../../components/ratings/ScoreCard.astro';
import UGCDisclaimer from '../../components/reviews/UGCDisclaimer.astro';
import BookmarkButton from '../../components/ui/BookmarkButton';
import PostSubmitVerification from '../../components/profile/PostSubmitVerification';
import BuildingRecords from '../../components/BuildingRecords.astro';
import { calculateBuildingAverages, getRecencyWeight, getReviewYear } from '../../lib/scoring';
import { currentReviewYear } from '../../lib/scoring-sql';
import {
  EARLY_RATING_HREF,
  EARLY_RATING_LABEL,
  buildingRateCounts,
  earlyScoreMarkerClass,
  isEarlyRating,
  issueRateText,
  recommendTally,
  scoreBasisText,
  scoreNumberClass,
  unitRecommendText,
  type RecommendTally,
} from '../../lib/earlyRating';
import { humanize } from '../../lib/format';
import {
  BUILDING_DETAIL_FIELDS,
  UNITS_LABEL,
  hasBuildingDetails,
  unitCountLabel,
  type BuildingDetailFields,
} from '../../lib/buildingDetails';
import { getCurrentAssessment } from '../../lib/records/query';
import { localityLine } from '../../lib/locality';
import { logError } from '../../lib/logger';
import { NO_CHECKLIST_ISSUES_COPY, resolveUnitType } from '../../lib/reviewDisplay';
import { buildingPageMeta } from '../../lib/buildingMeta';

type BuildingDetailRows = Record<
  (typeof BUILDING_DETAIL_FIELDS)[number],
  { label: string; format: (building: BuildingDetailFields) => unknown }
>;

// Label and formatter for each field in BUILDING_DETAIL_FIELDS, in display order —
// keeps the <dl> rows and the hasBuildingDetails check from drifting.
const buildingDetailRows: BuildingDetailRows = {
  // `?? ''` only satisfies the type: the row is guarded by `Boolean(building[field])` below,
  // so a blank building_type never reaches a formatter.
  building_type: { label: 'Type', format: (b) => humanize(b.building_type ?? '') },
  year_built: { label: 'Year built', format: (b) => b.year_built },
  // Relabelled below when the count is the seed's land-use estimate.
  unit_count: { label: UNITS_LABEL, format: (b) => b.unit_count },
};

const { slug } = Astro.params;
const submitted = Astro.url.searchParams.get('submitted') === 'true';
const reviewId = Astro.url.searchParams.get('reviewId');

let building: any = null;
let scores: any = null;
let reviews: any[] = [];
let landlord: any = null;
let isSaved = false;
let reviewAlreadyVerified = false;

// Unit type display order and labels
const unitTypeOrder = ['studio', '1br', '2br', '3br', '4br+', 'house'];
const unitTypeLabels: Record<string, string> = {
  'studio': 'Studio',
  '1br': '1 bedroom',
  '2br': '2 bedrooms',
  '3br': '3 bedrooms',
  '4br+': '4+ bedrooms',
  'house': 'House'
};

try {
  const db = Astro.locals.runtime.env.DB;

  const buildingResult = await db.prepare(`
    SELECT b.*,
           l.name as landlord_name, l.slug as landlord_slug,
           pm.name as property_manager_name, pm.slug as property_manager_slug
    FROM buildings b
    LEFT JOIN landlords l ON b.landlord_id = l.id
    LEFT JOIN property_managers pm ON b.property_manager_id = pm.id
    WHERE b.slug = ?
  `).bind(slug).first();

  if (buildingResult) {
    building = buildingResult;

    // Fetch all approved reviews (bounded at 500) — the header score, per-unit
    // stats, and review count are all derived from this array, so a low cap
    // would make them undercount buildings with many reviews. 500 far exceeds
    // any realistic building while bounding worst-case render cost.
    const reviewsResult = await db.prepare(`
      SELECT r.*
      FROM reviews r
      WHERE r.building_id = ? AND r.status = 'approved'
      ORDER BY r.created_at DESC
      LIMIT 500
    `).bind(building.id).all();

    reviews = reviewsResult.results || [];

    // Always compute from the fetched approved reviews — no cache table.
    if (reviews.length > 0) {
      scores = calculateBuildingAverages(reviews);
    }

    // Check if logged-in user has saved this building
    if (Astro.locals.user) {
      const savedResult = await db.prepare(
        'SELECT 1 FROM saved_buildings WHERE user_id = ? AND building_id = ?'
      ).bind(Astro.locals.user.id, building.id).first();
      isSaved = Boolean(savedResult);
    }

    // Check if submitted review is already verified (for post-submission prompt)
    if (submitted && reviewId && Astro.locals.user) {
      const verifyCheck = await db.prepare(
        'SELECT is_verified FROM reviews WHERE id = ? AND user_id = ?'
      ).bind(reviewId, Astro.locals.user.id).first<{ is_verified: number }>();
      reviewAlreadyVerified = Boolean(verifyCheck?.is_verified);
    }
  }
} catch (error) {
  console.error('Error loading building:', error);
}

if (!building) {
  return Astro.rewrite('/404');
}

// Group reviews by bedroom count only. Unit numbers are intentionally never
// used here — they're a tenant-identifying detail and must not appear publicly.
interface UnitStats {
  unitKey: string;
  unitType: string;
  displayName: string;
  reviewCount: number;
  avgScore: number;
  minRent: number | null;
  maxRent: number | null;
  recommend: RecommendTally;
  reviews: any[];
}

const reviewsByUnit = new Map<string, UnitStats>();

reviews.forEach(review => {
  // The bedrooms answer wins over a stored unit_type that disagrees with it (reviewDisplay.ts).
  const unitType = resolveUnitType(review) || 'unknown';
  const unitKey = unitType;
  const displayName = unitTypeLabels[unitType] || unitType;

  if (!reviewsByUnit.has(unitKey)) {
    reviewsByUnit.set(unitKey, {
      unitKey,
      unitType,
      displayName,
      reviewCount: 0,
      avgScore: 0,
      minRent: null,
      maxRent: null,
      recommend: { yes: 0, no: 0, maybe: 0 },
      reviews: []
    });
  }

  const stats = reviewsByUnit.get(unitKey)!;
  stats.reviews.push(review);
  stats.reviewCount++;
});

// Calculate aggregated stats for each unit using weighted scoring
const currentYear = currentReviewYear();
reviewsByUnit.forEach((stats) => {
  // Recency-weighted mean of the stored overall_score, matching the headline method.
  let weightedSum = 0;
  let weightTotal = 0;
  stats.reviews.forEach(review => {
    const stored = review.overall_score;
    if (stored === null || stored === undefined) return;
    const w = getRecencyWeight(getReviewYear(review, currentYear), currentYear);
    weightedSum += stored * w;
    weightTotal += w;
  });
  stats.avgScore = weightTotal > 0 ? Math.round((weightedSum / weightTotal) * 10) / 10 : 0;

  const rents = stats.reviews.filter(r => r.rent_amount).map(r => r.rent_amount);
  if (rents.length > 0) {
    stats.minRent = Math.min(...rents);
    stats.maxRent = Math.max(...rents);
  }

  // Yes, no and maybe answers, classified as calculateAggregatedScores does. The card's line
  // comes from unitRecommendText, which never turns a lone maybe into "0% recommend".
  stats.recommend = recommendTally(stats.reviews);
});

const sortedUnits = Array.from(reviewsByUnit.values())
  .sort((a, b) => unitTypeOrder.indexOf(a.unitType) - unitTypeOrder.indexOf(b.unitType));

const showBuildingDetails = hasBuildingDetails(building);

// "Units (estimated from land use)" when the stored count is the Boston seed's estimate, read
// off the same assessor record the facts strip shows (lib/buildingDetails.ts). A failed read
// costs only the label: the row keeps the plain "Units".
let unitsLabel = UNITS_LABEL;
if (building.unit_count) {
  try {
    const assessment = await getCurrentAssessment(Astro.locals.runtime.env.DB, building.id);
    unitsLabel = unitCountLabel(building.unit_count, assessment);
  } catch (error) {
    logError('building_units_assessment_failed', {
      buildingId: building.id,
      error: error instanceof Error ? error.message : String(error),
    });
  }
}
const detailRows: BuildingDetailRows = {
  ...buildingDetailRows,
  unit_count: { ...buildingDetailRows.unit_count, label: unitsLabel },
};

// With no approved review the city records are the page's content, so they come straight
// after the header and the header's "No reviews yet" line and button are the whole empty
// state. With reviews, the reviews come first and the records follow them.
const hasReviews = reviews.length > 0;
// Below the named-party threshold the headline score is an early rating: lighter, with its
// review count beside it, and the issue and recommend rates are counts (lib/earlyRating.ts).
const rates = hasReviews ? buildingRateCounts(reviews) : null;
const earlyRating = isEarlyRating(reviews.length);
// The records card sits in a row laid out like the main grid, so it is exactly as wide as
// the main column's cards at every breakpoint.
const recordsRowClass = 'grid lg:grid-cols-3 gap-8';
const recordsColumnClass = 'lg:col-span-2';
// A seeded Boston page with no review yet is a city-records page and its metadata says so.
// The fields are picked out one by one rather than cast: the building row is loosely typed
// here, and a cast would hide a column this ever stops selecting.
const meta = buildingPageMeta(
  {
    address: building.address,
    city: building.city,
    neighborhood: building.neighborhood,
    parcel_id: building.parcel_id ?? null,
  },
  reviews.length,
);
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {submitted && (
      <div class="mb-6 bg-teal-50 border border-teal-200 rounded-[6px] p-4" id="submitted-banner">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-teal-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="flex-1">
            <p class="text-teal-800 font-medium">Review submitted!</p>
            <p class="text-teal-700 text-sm">Your review has been submitted and is pending moderation. It will appear on this page once approved.</p>
          </div>
          <button type="button" aria-label="Close" data-dismiss="submitted-banner" class="text-teal-700 hover:text-teal-800">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        {reviewId && Astro.locals.user && (
          reviewAlreadyVerified ? (
            <div class="mt-3 pt-3 border-t border-teal-200 flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm text-blue-700 font-medium">Your review is already verified</span>
            </div>
          ) : (
            <PostSubmitVerification client:load reviewId={reviewId} />
          )
        )}
      </div>
    )}

    <!-- Header -->
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="text-sm text-gray-600 mb-4">
        {/* py-1 makes each link a 28px-tall target (bare text measured 17px); the matching
            negative margin keeps the header where it was. */}
        <a href="/" class="-my-1 inline-block py-1 hover:text-teal-700">Home</a>
        <span class="mx-2">/</span>
        <a href="/search" class="-my-1 inline-block py-1 hover:text-teal-700">Search</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">{building.address}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
        <div class="min-w-0 flex-1">
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 break-words">{building.address}</h1>
          <p class="text-lg text-gray-600">
            {localityLine({ address: building.address, neighborhood: building.neighborhood, city: building.city }, building.state)} {building.zip_code}
          </p>
          {(building.landlord_name || building.property_manager_name) && (
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-600">
              {/* Each name link is padded to a 28px-tall hit area (bare text measured 17px
                  tall), with a matching negative margin so the row keeps its height. */}
              {building.landlord_name && (
                <span>
                  Landlord:{' '}
                  <a href={`/landlord/${building.landlord_slug}`} class="-my-1 inline-block py-1 text-teal-700 hover:text-teal-800 font-medium">
                    {building.landlord_name}
                  </a>
                </span>
              )}
              {building.property_manager_name && (
                <span>
                  Managed by:{' '}
                  <a href={`/property-manager/${building.property_manager_slug}`} class="-my-1 inline-block py-1 text-purple-600 hover:text-purple-800 font-medium">
                    {building.property_manager_name}
                  </a>
                </span>
              )}
            </div>
          )}
        </div>

        <div class="flex flex-col items-end">
          {/* "No reviews yet" is gray-600, 6.87:1 on the paper background. gray-400 was
              2.37:1 and gray-500 is 4.40:1, both under WCAG AA's 4.5:1 for body text. */}
          {scores?.avg_overall && earlyRating ? (
            <div class="text-right" data-early-rating>
              <div class="flex items-baseline justify-end gap-2">
                <span aria-hidden="true" data-early-score-marker class={`${earlyScoreMarkerClass(scores.avg_overall)} self-center`}></span>
                <span class={`text-3xl ${scoreNumberClass(scores.avg_overall, scores.review_count)}`}>{scores.avg_overall.toFixed(1)}</span>
                <span class="text-sm text-gray-600 whitespace-nowrap">· {scoreBasisText(scores.review_count)}</span>
              </div>
              <div class="flex justify-end opacity-60">
                <StarRating rating={scores.avg_overall} />
              </div>
              <p class="text-xs text-gray-600 mt-1">
                <a href={EARLY_RATING_HREF} class="inline-block py-1 underline decoration-gray-300 underline-offset-2 hover:text-teal-700">{EARLY_RATING_LABEL}</a>
              </p>
            </div>
          ) : scores?.avg_overall ? (
            <div class="text-right">
              <div class={`text-4xl ${scoreNumberClass(scores.avg_overall, scores.review_count)}`}>{scores.avg_overall.toFixed(1)}</div>
              <StarRating rating={scores.avg_overall} />
              <p class="text-sm text-gray-600 mt-1">
                {scores.review_count} review{scores.review_count !== 1 ? 's' : ''}
              </p>
            </div>
          ) : (
            <p class="text-gray-600">No reviews yet</p>
          )}

          <div class="mt-4 flex items-center gap-2">
            {Astro.locals.user && (
              <BookmarkButton client:load buildingId={building.id} initialSaved={isSaved} />
            )}
            <a
              href={`/review/new?building=${building.id}`}
              class="inline-block bg-teal-700 text-white font-semibold px-6 py-2 rounded-[4px] hover:bg-teal-800 transition-colors"
            >
              Write a review
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* No approved review: the public records are the answer, so they come first. */}
    {!hasReviews && (
      <div class={recordsRowClass}>
        <div class={recordsColumnClass}>
          <BuildingRecords buildingId={building.id} />
        </div>
      </div>
    )}

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Sidebar -->
      {/* Rating cards only, so it is hidden when there is no review: an empty grid item
          would still add a row gap on a phone. */}
      <div class:list={['lg:col-start-3 lg:row-start-1 lg:col-span-1 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto', { hidden: !hasReviews }]}>
        {scores && <ScoreCard scores={scores} type="building" rates={rates ?? undefined} />}

        {scores && rates && scores.review_count > 0 && (
          <div class="bg-white rounded-[6px] border border-gray-200 p-6 mt-6">
            <h3 class="font-semibold text-gray-900 mb-4">Common issues reported</h3>
            {/* A count ("1 of 1 review") below the named-party threshold, the same percentage
                as before at or above it (issueRateText). */}
            <ul class="space-y-2 text-sm">
              {scores.pct_pest_issues > 0 && (
                <li class="flex justify-between gap-3">
                  <span class="text-gray-600">Pest issues</span>
                  <span class="text-red-700 font-medium whitespace-nowrap">{issueRateText(rates.issues.pest, rates.reviewCount)}</span>
                </li>
              )}
              {scores.pct_heat_issues > 0 && (
                <li class="flex justify-between gap-3">
                  <span class="text-gray-600">Heat/hot water issues</span>
                  <span class="text-orange-700 font-medium whitespace-nowrap">{issueRateText(rates.issues.heat, rates.reviewCount)}</span>
                </li>
              )}
              {scores.pct_water_issues > 0 && (
                <li class="flex justify-between gap-3">
                  <span class="text-gray-600">Water/plumbing issues</span>
                  <span class="text-blue-600 font-medium whitespace-nowrap">{issueRateText(rates.issues.water, rates.reviewCount)}</span>
                </li>
              )}
              {scores.pct_deposit_issues > 0 && (
                <li class="flex justify-between gap-3">
                  <span class="text-gray-600">Deposit issues</span>
                  <span class="text-yellow-700 font-medium whitespace-nowrap">{issueRateText(rates.issues.deposit, rates.reviewCount)}</span>
                </li>
              )}
            </ul>
            {scores.pct_pest_issues === 0 && scores.pct_heat_issues === 0 && scores.pct_water_issues === 0 && scores.pct_deposit_issues === 0 && (
              <p class="text-gray-500 text-sm">{NO_CHECKLIST_ISSUES_COPY}</p>
            )}
          </div>
        )}
      </div>

      <!-- Main Content -->
      <div class="lg:col-start-1 lg:row-start-1 lg:col-span-2">
        <!-- Building Details -->
        {showBuildingDetails && (
          <div class="bg-white rounded-[6px] border border-gray-200 p-6 mb-8">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Building details</h2>
            <dl class="grid grid-cols-2 gap-4">
              {BUILDING_DETAIL_FIELDS.map((field) => Boolean(building[field]) && (
                <>
                  <dt class="text-gray-500">{detailRows[field].label}</dt>
                  <dd class="text-gray-900">{detailRows[field].format(building)}</dd>
                </>
              ))}
            </dl>
          </div>
        )}

        <!-- Units Section -->
        {sortedUnits.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">
              Units reviewed ({sortedUnits.length} unit{sortedUnits.length !== 1 ? 's' : ''})
            </h2>
            <div class="space-y-3" id="unit-list">
              {sortedUnits.map((unitStats, index) => (
                <div class="unit-section" data-unit-key={unitStats.unitKey}>
                  {/* The card keeps its classes (plus `relative`) and its inner markup. A native
                      button laid over it, its last child, is the toggle, so the heading stays a
                      heading and the tests that read the card keep working. */}
                  <div
                    class="unit-card relative bg-white border border-gray-200 rounded-[6px] p-4 cursor-pointer hover:border-teal-300 hover:shadow-sm transition-all"
                    data-unit-key={unitStats.unitKey}
                    data-expanded={index === 0 ? "true" : "false"}
                  >
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-gray-100">
                          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                          </svg>
                        </div>
                        <div>
                          <h4 id={`unit-name-${index}`} class="font-semibold text-gray-900">{unitStats.displayName}</h4>
                          <p class="text-sm text-gray-500">
                            {unitStats.reviewCount} review{unitStats.reviewCount !== 1 ? 's' : ''}
                          </p>
                        </div>
                      </div>

                      <div class="flex items-center gap-4">
                        {(unitStats.minRent || unitStats.maxRent) && (
                          <div class="text-right hidden sm:block">
                            <p class="text-xs text-gray-500">Rent</p>
                            <p class="text-sm font-medium text-gray-900">
                              {unitStats.minRent === unitStats.maxRent
                                ? `$${unitStats.minRent?.toLocaleString()}`
                                : `$${unitStats.minRent?.toLocaleString()} - $${unitStats.maxRent?.toLocaleString()}`}
                            </p>
                          </div>
                        )}

                        <div class="text-right">
                          <div class="flex items-center gap-1">
                            {/* Early or not by the unit's own count, as unitRecommendText below is. */}
                            {isEarlyRating(unitStats.reviewCount) && (
                              <span aria-hidden="true" data-early-score-marker class={`${earlyScoreMarkerClass(unitStats.avgScore)} mr-0.5`}></span>
                            )}
                            <span data-unit-score class={`text-lg ${scoreNumberClass(unitStats.avgScore, unitStats.reviewCount)}`}>{unitStats.avgScore.toFixed(1)}</span>
                            <StarRating rating={unitStats.avgScore} size="sm" />
                          </div>
                          {unitRecommendText(unitStats.recommend, unitStats.reviewCount) && (
                            <p class="text-xs text-gray-500">
                              {unitRecommendText(unitStats.recommend, unitStats.reviewCount)}
                            </p>
                          )}
                        </div>

                        <svg
                          class={`w-5 h-5 text-gray-500 chevron-icon transition-transform motion-reduce:transition-none ${index === 0 ? 'rotate-180' : ''}`}
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </div>
                    </div>
                    <button
                      type="button"
                      class="absolute inset-0 z-10 w-full h-full cursor-[inherit] rounded-[6px]"
                      aria-labelledby={`unit-name-${index}`}
                      aria-expanded={index === 0 ? 'true' : 'false'}
                      aria-controls={`unit-reviews-${index}`}
                    ></button>
                  </div>
                  <div
                    id={`unit-reviews-${index}`}
                    class={`unit-reviews mt-4 space-y-4 pl-4 border-l-2 border-teal-200 ${index === 0 ? '' : 'hidden'}`}
                    data-reviews-for={unitStats.unitKey}
                  >
                    {unitStats.reviews.map((review) => (
                      <ReviewCard review={review} />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* The line about tenant-written reviews describes reviews, so it shows only with some. */}
        {hasReviews && <UGCDisclaimer />}
      </div>
    </div>

    {/* With reviews, public records sit below the reviews and the rating sidebar: reviews and
        the sidebar are the judgment layer, records are the reference. */}
    {hasReviews && (
      <div class:list={[recordsRowClass, 'mt-8']}>
        <div class={recordsColumnClass}>
          <BuildingRecords buildingId={building.id} />
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  // Collapsible unit sections. Each card's overlay button is the toggle: a click, Enter or Space
  // shows or hides the panel it controls and keeps the button, the card and the chevron in step.
  // The first card renders open, chevron turned, from the server.
  document.querySelectorAll<HTMLButtonElement>('.unit-card > button[aria-controls]').forEach((button) => {
    button.addEventListener('click', () => {
      const card = button.closest('.unit-card');
      const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!card || !panel) return;

      const expand = button.getAttribute('aria-expanded') !== 'true';
      panel.classList.toggle('hidden', !expand);
      button.setAttribute('aria-expanded', String(expand));
      card.setAttribute('data-expanded', String(expand));
      card.querySelector('.chevron-icon')?.classList.toggle('rotate-180', expand);
    });
  });
</script>
