---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import StarRating from '../../components/ratings/StarRating.astro';
import ReviewCard from '../../components/reviews/ReviewCard.astro';
import ScoreCard from '../../components/ratings/ScoreCard.astro';
import UGCDisclaimer from '../../components/reviews/UGCDisclaimer.astro';
import BookmarkButton from '../../components/ui/BookmarkButton';
import PostSubmitVerification from '../../components/profile/PostSubmitVerification';
import EmptyState from '../../components/ui/EmptyState.astro';
import { calculateBuildingAverages, calculateDomainScores } from '../../lib/scoring';
import { getScoreTextColor } from '../../lib/scoring-colors';

const { slug } = Astro.params;
const submitted = Astro.url.searchParams.get('submitted') === 'true';
const reviewId = Astro.url.searchParams.get('reviewId');

let building: any = null;
let scores: any = null;
let reviews: any[] = [];
let landlord: any = null;
let isSaved = false;
let reviewAlreadyVerified = false;

// Unit type display order and labels
const unitTypeOrder = ['studio', '1br', '2br', '3br', '4br+', 'house'];
const unitTypeLabels: Record<string, string> = {
  'studio': 'Studio',
  '1br': '1 bedroom',
  '2br': '2 bedrooms',
  '3br': '3 bedrooms',
  '4br+': '4+ bedrooms',
  'house': 'House'
};

try {
  const db = Astro.locals.runtime.env.DB;

  const buildingResult = await db.prepare(`
    SELECT b.*,
           l.name as landlord_name, l.slug as landlord_slug,
           pm.name as property_manager_name, pm.slug as property_manager_slug
    FROM buildings b
    LEFT JOIN landlords l ON b.landlord_id = l.id
    LEFT JOIN property_managers pm ON b.property_manager_id = pm.id
    WHERE b.slug = ?
  `).bind(slug).first();

  if (buildingResult) {
    building = buildingResult;

    const scoresResult = await db.prepare(`
      SELECT * FROM building_scores WHERE building_id = ?
    `).bind(building.id).first();

    scores = scoresResult;

    const reviewsResult = await db.prepare(`
      SELECT r.*, u.email_verified as user_email_verified
      FROM reviews r
      LEFT JOIN users u ON r.user_id = u.id
      WHERE r.building_id = ? AND r.status = 'approved'
      ORDER BY r.created_at DESC
      LIMIT 50
    `).bind(building.id).all();

    reviews = reviewsResult.results || [];

    // If we have reviews but building_scores doesn't have domain scores,
    // calculate them from the reviews
    if (reviews.length > 0 && scores && !scores.avg_unit && !scores.avg_building && !scores.avg_landlord) {
      const calculatedScores = calculateBuildingAverages(reviews);
      scores = { ...scores, ...calculatedScores };
    } else if (reviews.length > 0 && !scores) {
      // No building_scores record at all, calculate everything
      scores = calculateBuildingAverages(reviews);
    }

    // Check if logged-in user has saved this building
    if (Astro.locals.user) {
      const savedResult = await db.prepare(
        'SELECT 1 FROM saved_buildings WHERE user_id = ? AND building_id = ?'
      ).bind(Astro.locals.user.id, building.id).first();
      isSaved = Boolean(savedResult);
    }

    // Check if submitted review is already verified (for post-submission prompt)
    if (submitted && reviewId && Astro.locals.user) {
      const verifyCheck = await db.prepare(
        'SELECT is_verified FROM reviews WHERE id = ? AND user_id = ?'
      ).bind(reviewId, Astro.locals.user.id).first<{ is_verified: number }>();
      reviewAlreadyVerified = Boolean(verifyCheck?.is_verified);
    }
  }
} catch (error) {
  console.error('Error loading building:', error);
}

if (!building) {
  return Astro.redirect('/404');
}

// Group reviews by bedroom count only. Unit numbers are intentionally never
// used here — they're a tenant-identifying detail and must not appear publicly.
interface UnitStats {
  unitKey: string;
  unitType: string;
  displayName: string;
  reviewCount: number;
  avgScore: number;
  minRent: number | null;
  maxRent: number | null;
  wouldRecommendPct: number;
  reviews: any[];
}

const reviewsByUnit = new Map<string, UnitStats>();

reviews.forEach(review => {
  const unitType = review.unit_type || 'unknown';
  const unitKey = unitType;
  const displayName = unitTypeLabels[unitType] || unitType;

  if (!reviewsByUnit.has(unitKey)) {
    reviewsByUnit.set(unitKey, {
      unitKey,
      unitType,
      displayName,
      reviewCount: 0,
      avgScore: 0,
      minRent: null,
      maxRent: null,
      wouldRecommendPct: 0,
      reviews: []
    });
  }

  const stats = reviewsByUnit.get(unitKey)!;
  stats.reviews.push(review);
  stats.reviewCount++;
});

// Calculate aggregated stats for each unit using weighted scoring
reviewsByUnit.forEach((stats) => {
  // Calculate weighted average score using the same methodology
  let scoreSum = 0;
  let scoreCount = 0;
  stats.reviews.forEach(review => {
    const domainScores = calculateDomainScores(review);
    if (domainScores.overall !== null) {
      scoreSum += domainScores.overall;
      scoreCount++;
    } else if (review.overall_score) {
      // Fallback to stored overall_score if available
      scoreSum += review.overall_score;
      scoreCount++;
    }
  });
  stats.avgScore = scoreCount > 0 ? scoreSum / scoreCount : 0;

  const rents = stats.reviews.filter(r => r.rent_amount).map(r => r.rent_amount);
  if (rents.length > 0) {
    stats.minRent = Math.min(...rents);
    stats.maxRent = Math.max(...rents);
  }

  // Check both old and new would_recommend fields
  const recommends = stats.reviews.filter(r =>
    r.would_recommend === 1 || r.would_recommend_new === 'yes'
  ).length;
  stats.wouldRecommendPct = stats.reviewCount > 0 ? (recommends / stats.reviewCount) * 100 : 0;
});

const sortedUnits = Array.from(reviewsByUnit.values())
  .sort((a, b) => unitTypeOrder.indexOf(a.unitType) - unitTypeOrder.indexOf(b.unitType));
---

<BaseLayout title={building.address} description={`Reviews for ${building.address} in ${building.neighborhood || building.city}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {submitted && (
      <div class="mb-6 bg-teal-50 border border-teal-200 rounded-[6px] p-4" id="submitted-banner">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-teal-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="flex-1">
            <p class="text-teal-800 font-medium">Review submitted!</p>
            <p class="text-teal-700 text-sm">Your review has been submitted and is pending moderation. It will appear on this page once approved.</p>
          </div>
          <button onclick="document.getElementById('submitted-banner').remove()" class="text-teal-400 hover:text-teal-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        {reviewId && Astro.locals.user && (
          reviewAlreadyVerified ? (
            <div class="mt-3 pt-3 border-t border-teal-200 flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm text-blue-700 font-medium">Your review is already verified</span>
            </div>
          ) : (
            <PostSubmitVerification client:load reviewId={reviewId} />
          )
        )}
      </div>
    )}

    <!-- Header -->
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2">/</span>
        <a href="/search" class="hover:text-teal-700">Search</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">{building.address}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
        <div class="min-w-0 flex-1">
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 break-words">{building.address}</h1>
          <p class="text-lg text-gray-600">
            {building.neighborhood && `${building.neighborhood}, `}{building.city}, {building.state} {building.zip_code}
          </p>
          {(building.landlord_name || building.property_manager_name) && (
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
              {building.landlord_name && (
                <span>
                  Landlord:{' '}
                  <a href={`/landlord/${building.landlord_slug}`} class="text-teal-700 hover:text-teal-800 font-medium">
                    {building.landlord_name}
                  </a>
                </span>
              )}
              {building.property_manager_name && (
                <span>
                  Managed by:{' '}
                  <a href={`/property-manager/${building.property_manager_slug}`} class="text-purple-600 hover:text-purple-800 font-medium">
                    {building.property_manager_name}
                  </a>
                </span>
              )}
            </div>
          )}
        </div>

        <div class="flex flex-col items-end">
          {scores?.avg_overall ? (
            <div class="text-right">
              <div class={`text-4xl font-bold ${getScoreTextColor(scores.avg_overall)}`}>{scores.avg_overall.toFixed(1)}</div>
              <StarRating rating={scores.avg_overall} />
              <p class="text-sm text-gray-500 mt-1">
                {scores.review_count} review{scores.review_count !== 1 ? 's' : ''}
              </p>
            </div>
          ) : (
            <p class="text-gray-400">No reviews yet</p>
          )}

          <div class="mt-4 flex items-center gap-2">
            {Astro.locals.user && (
              <BookmarkButton client:load buildingId={building.id} initialSaved={isSaved} />
            )}
            <a
              href={`/review/new?building=${building.id}`}
              class="inline-block bg-teal-700 text-white font-semibold px-6 py-2 rounded-[4px] hover:bg-teal-800 transition-colors"
            >
              Write a review
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <!-- Building Details -->
        <div class="bg-white rounded-[6px] border border-gray-200 p-6 mb-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Building details</h2>
          <dl class="grid grid-cols-2 gap-4">
            {building.building_type && (
              <>
                <dt class="text-gray-500">Type</dt>
                <dd class="text-gray-900">{building.building_type}</dd>
              </>
            )}
            {building.year_built && (
              <>
                <dt class="text-gray-500">Year built</dt>
                <dd class="text-gray-900">{building.year_built}</dd>
              </>
            )}
            {building.unit_count && (
              <>
                <dt class="text-gray-500">Units</dt>
                <dd class="text-gray-900">{building.unit_count}</dd>
              </>
            )}
          </dl>
        </div>

        <!-- Units Section -->
        {sortedUnits.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">
              Units reviewed ({sortedUnits.length} unit{sortedUnits.length !== 1 ? 's' : ''})
            </h2>
            <div class="space-y-3" id="unit-list">
              {sortedUnits.map((unitStats, index) => (
                <div class="unit-section" data-unit-key={unitStats.unitKey}>
                  <div
                    class="unit-card bg-white border border-gray-200 rounded-[6px] p-4 cursor-pointer hover:border-teal-300 hover:shadow-sm transition-all"
                    data-unit-key={unitStats.unitKey}
                    data-expanded={index === 0 ? "true" : "false"}
                  >
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-gray-100">
                          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                          </svg>
                        </div>
                        <div>
                          <h4 class="font-semibold text-gray-900">{unitStats.displayName}</h4>
                          <p class="text-sm text-gray-500">
                            {unitStats.reviewCount} review{unitStats.reviewCount !== 1 ? 's' : ''}
                          </p>
                        </div>
                      </div>

                      <div class="flex items-center gap-4">
                        {(unitStats.minRent || unitStats.maxRent) && (
                          <div class="text-right hidden sm:block">
                            <p class="text-xs text-gray-500">Rent</p>
                            <p class="text-sm font-medium text-gray-900">
                              {unitStats.minRent === unitStats.maxRent
                                ? `$${unitStats.minRent?.toLocaleString()}`
                                : `$${unitStats.minRent?.toLocaleString()} - $${unitStats.maxRent?.toLocaleString()}`}
                            </p>
                          </div>
                        )}

                        <div class="text-right">
                          <div class="flex items-center gap-1">
                            <span class={`text-lg font-bold ${getScoreTextColor(unitStats.avgScore)}`}>{unitStats.avgScore.toFixed(1)}</span>
                            <StarRating rating={unitStats.avgScore} size="sm" />
                          </div>
                          <p class="text-xs text-gray-500">
                            {Math.round(unitStats.wouldRecommendPct)}% recommend
                          </p>
                        </div>

                        <svg
                          class="w-5 h-5 text-gray-400 chevron-icon transition-transform"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </div>
                    </div>
                  </div>
                  <div
                    class={`unit-reviews mt-4 space-y-4 pl-4 border-l-2 border-teal-200 ${index === 0 ? '' : 'hidden'}`}
                    data-reviews-for={unitStats.unitKey}
                  >
                    {unitStats.reviews.map((review) => (
                      <ReviewCard review={review} />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- No Reviews State -->
        {reviews.length === 0 && (
          <EmptyState
            title="No reviews yet for this building."
            description="Be the first to share your experience with this property."
            action={{ label: 'Be the first to write a review', href: `/review/new?building=${building.id}` }}
          >
            <svg slot="icon" class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
          </EmptyState>
        )}

        <UGCDisclaimer />
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        {scores && <ScoreCard scores={scores} type="building" />}

        {scores && scores.review_count > 0 && (
          <div class="bg-white rounded-[6px] border border-gray-200 p-6 mt-6">
            <h3 class="font-semibold text-gray-900 mb-4">Common issues reported</h3>
            <ul class="space-y-2 text-sm">
              {scores.pct_pest_issues > 0 && (
                <li class="flex justify-between">
                  <span class="text-gray-600">Pest issues</span>
                  <span class="text-red-600 font-medium">{Math.round(scores.pct_pest_issues)}%</span>
                </li>
              )}
              {scores.pct_heat_issues > 0 && (
                <li class="flex justify-between">
                  <span class="text-gray-600">Heat/hot water issues</span>
                  <span class="text-orange-600 font-medium">{Math.round(scores.pct_heat_issues)}%</span>
                </li>
              )}
              {scores.pct_water_issues > 0 && (
                <li class="flex justify-between">
                  <span class="text-gray-600">Water/plumbing issues</span>
                  <span class="text-blue-600 font-medium">{Math.round(scores.pct_water_issues)}%</span>
                </li>
              )}
              {scores.pct_deposit_issues > 0 && (
                <li class="flex justify-between">
                  <span class="text-gray-600">Deposit issues</span>
                  <span class="text-yellow-600 font-medium">{Math.round(scores.pct_deposit_issues)}%</span>
                </li>
              )}
            </ul>
            {scores.pct_pest_issues === 0 && scores.pct_heat_issues === 0 && scores.pct_water_issues === 0 && scores.pct_deposit_issues === 0 && (
              <p class="text-gray-500 text-sm">No issues reported</p>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Handle collapsible unit sections
  document.querySelectorAll('.unit-card').forEach(card => {
    card.addEventListener('click', () => {
      const unitKey = card.getAttribute('data-unit-key');
      const reviewsContainer = document.querySelector(`[data-reviews-for="${unitKey}"]`);
      const isExpanded = card.getAttribute('data-expanded') === 'true';
      const chevron = card.querySelector('.chevron-icon');

      if (reviewsContainer) {
        if (isExpanded) {
          reviewsContainer.classList.add('hidden');
          card.setAttribute('data-expanded', 'false');
          chevron?.classList.remove('rotate-180');
        } else {
          reviewsContainer.classList.remove('hidden');
          card.setAttribute('data-expanded', 'true');
          chevron?.classList.add('rotate-180');
        }
      }
    });
  });

  // Set initial chevron state for expanded cards
  document.querySelectorAll('.unit-card[data-expanded="true"] .chevron-icon').forEach(chevron => {
    chevron.classList.add('rotate-180');
  });
</script>
