---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ReviewSigninNote from '../../components/auth/ReviewSigninNote.astro';
import { redirectQuery, safeRedirectPath } from '../../lib/authRedirect';
import { loadReviewSigninContext } from '../../lib/reviewSignin';
import { maybeEnv } from '../../lib/runtime';

// Where to go after signing in. Validated here and again in the page script before it
// navigates; an unsafe or missing value is '/', which also keeps every link below bare.
const redirectTo = safeRedirectPath(Astro.url.searchParams.get('redirect'));

// Redirect if already logged in
if (Astro.locals.user) {
  return Astro.redirect(redirectTo);
}

// The same note sign-in shows when the return path is the review form; null otherwise.
const reviewContext = await loadReviewSigninContext(maybeEnv(Astro.locals)?.DB, redirectTo);
---

<BaseLayout title="Sign up" noindex>
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full space-y-8">
      <div>
        <h1 class="text-center text-3xl font-bold text-gray-900">Create your account</h1>
        <p class="mt-2 text-center text-sm text-gray-600">
          Already have an account?{' '}
          <a href={'/auth/signin' + redirectQuery(redirectTo)} class="font-medium text-teal-700 hover:text-teal-800">
            Sign in
          </a>
        </p>
        {reviewContext && <ReviewSigninNote place={reviewContext.place} />}
      </div>

      <div class="mt-8">
        <a
          href={'/api/auth/google' + redirectQuery(redirectTo)}
          class="w-full flex items-center justify-center gap-3 py-2.5 px-4 border border-slate-200 rounded-[4px] bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-700"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Continue with Google
        </a>
      </div>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-white text-gray-500">Or continue with email</span>
        </div>
      </div>

      <form id="signup-form" class="space-y-6" data-redirect={redirectTo}>
        <div id="error-message" role="alert" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded"></div>

        <div class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700">
              Email address
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-[4px] shadow-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-500"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-gray-700">
              Password
            </label>
            <div class="relative mt-1">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                minlength="6"
                class="block w-full px-3 py-2 pr-10 border border-gray-300 rounded-[4px] shadow-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-500"
              />
              <button
                type="button"
                class="toggle-password absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-600"
                data-target="password"
                aria-label="Toggle password visibility"
                aria-pressed="false"
              >
                <svg class="eye-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg class="eye-off-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
            <p class="mt-1 text-xs text-gray-600">At least 6 characters</p>
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-gray-700">
              Confirm Password
            </label>
            <div class="relative mt-1">
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                required
                minlength="6"
                class="block w-full px-3 py-2 pr-10 border border-gray-300 rounded-[4px] shadow-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-500"
              />
              <button
                type="button"
                class="toggle-password absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-600"
                data-target="confirmPassword"
                aria-label="Toggle password visibility"
                aria-pressed="false"
              >
                <svg class="eye-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg class="eye-off-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="text-sm text-gray-600">
          By signing up, you agree to our{' '}
          <a href="/terms" class="inline-block py-1 text-teal-700 hover:text-teal-800">Terms of Service</a>
          {' '}and{' '}
          <a href="/privacy" class="inline-block py-1 text-teal-700 hover:text-teal-800">Privacy Policy</a>.
        </div>

        <div id="turnstile-container" class="flex justify-center"></div>

        <button
          type="submit"
          class="w-full h-11 flex items-center justify-center px-4 border border-transparent rounded-[4px] text-sm font-semibold text-white bg-teal-700 hover:bg-teal-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-700 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Create account
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  import { safeRedirectPath } from '../../lib/authRedirect';

  // Password visibility toggles
  document.querySelectorAll('.toggle-password').forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('data-target');
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement;
      const eyeIcon = button.querySelector('.eye-icon');
      const eyeOffIcon = button.querySelector('.eye-off-icon');

      if (input.type === 'password') {
        input.type = 'text';
        button.setAttribute('aria-pressed', 'true');
        eyeIcon?.classList.add('hidden');
        eyeOffIcon?.classList.remove('hidden');
      } else {
        input.type = 'password';
        button.setAttribute('aria-pressed', 'false');
        eyeIcon?.classList.remove('hidden');
        eyeOffIcon?.classList.add('hidden');
      }
    });
  });

  const form = document.getElementById('signup-form') as HTMLFormElement;
  const errorMessage = document.getElementById('error-message') as HTMLDivElement;

  // Explicit render instead of the declarative cf-turnstile div: implicit
  // auto-scan reserves a fixed-size placeholder as soon as the script loads,
  // even if the widget never mounts (e.g. an unallowlisted preview domain).
  // Rendering explicitly into an empty, unstyled container avoids that
  // reserved height — see ContactForm/DisputeForm for the same pattern.
  let turnstileWidgetId: string | null = null;

  function renderTurnstile() {
    const container = document.getElementById('turnstile-container');
    const turnstile = window.turnstile;
    if (!container || !turnstile || turnstileWidgetId) return;
    turnstileWidgetId = turnstile.render(container, {
      sitekey: '0x4AAAAAACo4KpkxsacPhM2r',
      theme: 'light',
    });
  }

  if (window.turnstile) {
    renderTurnstile();
  } else {
    // Bound the poll so a blocked/failed script load doesn't spin forever:
    // 100 ticks at 100ms = 10s, then give up.
    let turnstilePollAttempts = 0;
    const turnstileInterval: ReturnType<typeof setInterval> = setInterval(() => {
      // The page can be rendered outside a browser (container tests); a tick after that
      // teardown must stop rather than touch a window that no longer exists.
      if (typeof window === 'undefined') {
        clearInterval(turnstileInterval);
        return;
      }
      turnstilePollAttempts++;
      if (window.turnstile) {
        clearInterval(turnstileInterval);
        renderTurnstile();
      } else if (turnstilePollAttempts >= 100) {
        clearInterval(turnstileInterval);
      }
    }, 100);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    const password = formData.get('password');
    const confirmPassword = formData.get('confirmPassword');

    if (password !== confirmPassword) {
      errorMessage.classList.remove('hidden');
      errorMessage.textContent = 'Passwords do not match';
      return;
    }

    button.disabled = true;
    button.textContent = 'Creating account...';
    errorMessage.classList.add('hidden');

    try {
      const response = await fetch('/api/auth/signup', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (response.ok) {
        // data-redirect was validated server-side; validate again, since the DOM is not
        // the server and this is the line that navigates.
        window.location.href = safeRedirectPath(form.dataset.redirect);
      } else {
        errorMessage.classList.remove('hidden');
        errorMessage.textContent = result.error || 'An error occurred';
      }
    } catch {
      errorMessage.classList.remove('hidden');
      errorMessage.textContent = 'An error occurred. Please try again.';
    } finally {
      button.disabled = false;
      button.textContent = 'Create account';
      // A Turnstile token is single-use — reset the widget after every
      // attempt so a retry gets a fresh token instead of a spent one.
      if (turnstileWidgetId && window.turnstile) {
        window.turnstile.reset(turnstileWidgetId);
      }
    }
  });
</script>
