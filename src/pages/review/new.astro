---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ReviewForm from '../../components/reviews/ReviewForm';
import { logError } from '../../lib/logger';
import { fetchPlaceDetails } from '../../lib/places';
import { checkRateLimit } from '../../lib/rateLimit';
import {
  HANDOFF_COPY,
  loadReviewFormBuilding,
  resolveReviewHandoff,
  type HandoffPlace,
  type ReviewFormBuilding,
} from '../../lib/reviewHandoff';
import { existingBuildingReviewPath } from '../../lib/reviewPaths';

// GET never writes a `buildings` row; see AGENTS.md Traps. The ?placeId= handoff resolves
// read-only and either redirects to the existing building or pre-fills the address step,
// whose Continue POSTs /api/buildings. Island props come only from loadReviewFormBuilding's
// four columns.

// Require authentication. Preserve the full query string so users sent
// here from the homepage with ?placeId=... land back on the same page
// after signing in.
if (!Astro.locals.user) {
  const returnTo = Astro.url.pathname + Astro.url.search;
  return Astro.redirect('/auth/signin?redirect=' + encodeURIComponent(returnTo));
}
const user = Astro.locals.user;

const buildingIdParam = Astro.url.searchParams.get('building');
const placeIdParam = Astro.url.searchParams.get('placeId');
let building: ReviewFormBuilding | null = null;
let initialPlace: HandoffPlace | null = null;
let resolveError: string | null = null;
let resolveNote: string | null = null;

const env = Astro.locals.runtime.env;
const db = env.DB;

if (buildingIdParam) {
  try {
    building = await loadReviewFormBuilding(db, buildingIdParam);
    if (!building) {
      resolveError = HANDOFF_COPY.notFound;
    } else if (Astro.url.searchParams.get('partOf') === '1') {
      // Set by the handoff when the city's parcel spans more numbers than the one picked.
      resolveNote = HANDOFF_COPY.partOf(building.address);
    }
  } catch (error) {
    logError('review_form_load_failed', { error: error instanceof Error ? error.message : String(error) });
    resolveError = HANDOFF_COPY.failed;
  }
} else if (placeIdParam) {
  // ?placeId=... handoff from the homepage "Add a review for this address" path.
  const apiKey = env.GOOGLE_PLACES_API_KEY || env.GOOGLE_MAPS_API_KEY;
  const result = await resolveReviewHandoff(
    {
      db,
      fetchPlace: apiKey ? (id) => fetchPlaceDetails(id, apiKey) : null,
      // Spent only right before the paid Google call; a known place id never reaches it.
      allowPlacesLookup: async () => (await checkRateLimit(db, user.id, 'review-handoff', 30, 3600)).allowed,
    },
    placeIdParam,
  );
  if (result.kind === 'existing') {
    // One render path for the handoff and the "Existing properties" click, and a reload
    // of the ?building= URL costs nothing.
    return Astro.redirect(existingBuildingReviewPath(result.buildingId, { partOf: result.partOf }));
  }
  if (result.kind === 'confirm') initialPlace = result.place;
  else resolveError = result.message;
}
---

<BaseLayout title="Write a Review" noindex>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Write a Review</h1>
    <p class="text-gray-600 mb-8">
      Share your experience to help other tenants make informed decisions.
    </p>

    {resolveError && (
      <div class="bg-amber-50 border border-amber-200 rounded-[6px] p-4 mb-6 text-amber-800 text-sm">
        {resolveError}
      </div>
    )}

    {resolveNote && (
      <div class="bg-teal-50 border border-teal-200 rounded-[6px] p-4 mb-6 text-teal-800 text-sm">
        {resolveNote}
      </div>
    )}

    <div class="bg-yellow-50 border border-yellow-200 rounded-[6px] p-4 mb-8">
      <h2 class="font-semibold text-yellow-800 mb-2">Privacy Notice</h2>
      <ul class="text-sm text-yellow-700 space-y-1">
        <li>Your move-in and move-out dates will be shown as seasons (e.g., "Fall 2023"), not exact dates.</li>
        <li>Your email address will never be displayed publicly.</li>
        <li>Reviews are moderated before publishing to ensure they meet our guidelines.</li>
      </ul>
    </div>

    <ReviewForm client:load building={building} initialPlace={initialPlace} />
  </div>
</BaseLayout>

<script is:inline data-rmp-turnstile-guard>
  // A Turnstile script that fails to load removes itself, so ConfirmStep's "Try again" can tell a
  // failed load (no tag left) from a slow one (tag still pending) and never runs api.js twice.
  window.addEventListener('error', function (e) {
    var t = e.target;
    if (t && t.tagName === 'SCRIPT' && typeof t.src === 'string' &&
        t.src.indexOf('https://challenges.cloudflare.com/turnstile/') === 0 && t.parentNode) {
      t.parentNode.removeChild(t);
    }
  }, true);
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
