---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ReviewForm from '../../components/reviews/ReviewForm';
import { generateIdFromEntropySize } from 'lucia';

// Require authentication. Preserve the full query string so users sent
// here from the homepage with ?placeId=... land back on the same page
// after signing in.
if (!Astro.locals.user) {
  const returnTo = Astro.url.pathname + Astro.url.search;
  return Astro.redirect('/auth/signin?redirect=' + encodeURIComponent(returnTo));
}

const buildingIdParam = Astro.url.searchParams.get('building');
const placeIdParam = Astro.url.searchParams.get('placeId');
let building: any = null;
let resolveError: string | null = null;

const db = Astro.locals.runtime.env.DB;

if (buildingIdParam) {
  try {
    building = await db.prepare('SELECT * FROM buildings WHERE id = ?').bind(buildingIdParam).first();
  } catch (error) {
    console.error('Error loading building:', error);
  }
} else if (placeIdParam) {
  // ?placeId=... handoff from the homepage "Add a review for this address" path.
  // Resolve the Google place to a buildings row (existing or freshly created)
  // so the form opens directly at the unit-details step. No retyping.
  try {
    const existing = await db
      .prepare('SELECT * FROM buildings WHERE google_place_id = ?')
      .bind(placeIdParam)
      .first();

    if (existing) {
      building = existing;
    } else {
      const env = Astro.locals.runtime.env;
      const apiKey = env.GOOGLE_PLACES_API_KEY || env.GOOGLE_MAPS_API_KEY;
      if (!apiKey) {
        resolveError = 'Address lookup is temporarily unavailable. Please search for your address below.';
      } else {
        const response = await fetch(`https://places.googleapis.com/v1/places/${placeIdParam}`, {
          headers: {
            'Content-Type': 'application/json',
            'X-Goog-Api-Key': apiKey,
            'X-Goog-FieldMask': 'id,formattedAddress,addressComponents,location,displayName',
            'Referer': 'https://ratemyplace.org/',
          },
        });
        const data: any = await response.json();
        if (data.error || !data.addressComponents) {
          console.error('Place Details API error on /review/new handoff:', data.error || 'no addressComponents');
          resolveError = 'We could not look up that address. Please search for it below.';
        } else {
          const components = data.addressComponents;
          const getComponent = (type: string): string => {
            const comp = components.find((c: any) => c.types.includes(type));
            return comp?.longText || '';
          };
          const getComponentShort = (type: string): string => {
            const comp = components.find((c: any) => c.types.includes(type));
            return comp?.shortText || '';
          };

          const streetNumber = getComponent('street_number');
          const streetName = getComponent('route');
          const streetAddress = streetNumber ? `${streetNumber} ${streetName}` : streetName;
          const city = getComponent('locality') || getComponent('sublocality');
          const state = getComponentShort('administrative_area_level_1');
          const zipCode = getComponent('postal_code');
          const neighborhood = getComponent('neighborhood') || getComponent('sublocality_level_1');
          const latitude = data.location?.latitude;
          const longitude = data.location?.longitude;

          if (!streetAddress || !city) {
            resolveError = 'That address came back incomplete. Please enter it manually below.';
          } else {
            const safeAddress = streetAddress.slice(0, 500);
            let slug =
              safeAddress.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') +
              '-' +
              city.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            const slugCheck = await db.prepare('SELECT id FROM buildings WHERE slug = ?').bind(slug).first();
            if (slugCheck) {
              slug = slug + '-' + Date.now().toString(36);
            }
            const newId = generateIdFromEntropySize(10);
            await db
              .prepare(
                `INSERT INTO buildings (id, address, slug, neighborhood, city, state, zip_code, latitude, longitude, google_place_id)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
              )
              .bind(
                newId,
                safeAddress,
                slug,
                neighborhood || null,
                city,
                state || null,
                zipCode || null,
                latitude || null,
                longitude || null,
                data.id || placeIdParam
              )
              .run();
            building = { id: newId, address: safeAddress, slug, neighborhood: neighborhood || null, city };
          }
        }
      }
    }
  } catch (error) {
    console.error('Error resolving building from placeId:', error);
    resolveError = 'Something went wrong loading that address. Please search for it below.';
  }
}
---

<BaseLayout title="Write a Review">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Write a Review</h1>
    <p class="text-gray-600 mb-8">
      Share your experience to help other tenants make informed decisions.
    </p>

    {resolveError && (
      <div class="bg-amber-50 border border-amber-200 rounded-[6px] p-4 mb-6 text-amber-800 text-sm">
        {resolveError}
      </div>
    )}

    <div class="bg-yellow-50 border border-yellow-200 rounded-[6px] p-4 mb-8">
      <h2 class="font-semibold text-yellow-800 mb-2">Privacy Notice</h2>
      <ul class="text-sm text-yellow-700 space-y-1">
        <li>Your move-in and move-out dates will be shown as seasons (e.g., "Fall 2023"), not exact dates.</li>
        <li>Your email address will never be displayed publicly.</li>
        <li>Reviews are moderated before publishing to ensure they meet our guidelines.</li>
      </ul>
    </div>

    <ReviewForm client:load building={building} />
  </div>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
