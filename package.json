{
  "name": "ratemyplace",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "e2e": "npm run db:setup && npm run build && npx playwright test",
    "e2e:headed": "npm run db:setup && npm run build && npx playwright test --headed",
    "db:reset": "npx tsx scripts/db-reset.ts",
    "db:migrate:local": "npx tsx scripts/db-migrate.ts",
    "db:fresh": "npx tsx scripts/db-fresh.ts",
    "db:seed": "npx tsx scripts/db-seed.ts",
    "db:setup": "npm run db:fresh && npm run db:seed"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/react": "3.6.3",
    "@lucia-auth/adapter-sqlite": "^3.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "astro": "^5.16.11",
    "lucia": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260117.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "happy-dom": "^20.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
