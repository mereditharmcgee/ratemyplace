{
  "name": "ratemyplace",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "e2e:preflight": "tsx e2e/preflight.ts",
    "e2e": "npm run e2e:preflight && npm run db:setup && npm run build && npx playwright test",
    "e2e:headed": "npm run e2e:preflight && npm run db:setup && npm run build && npx playwright test --headed",
    "db:reset": "npx tsx scripts/db-reset.ts",
    "db:migrate:local": "npx tsx scripts/db-migrate.ts",
    "db:fresh": "npx tsx scripts/db-fresh.ts",
    "db:seed": "npx tsx scripts/db-seed.ts",
    "db:setup": "npm run db:fresh && npm run db:seed",
    "ops:metrics": "tsx scripts/ops-metrics.ts",
    "records:check": "npx tsx scripts/records-fixture-check.ts",
    "records:seed": "npx tsx scripts/records-seed-boston.ts",
    "records:worker": "npx wrangler dev --config workers/records-scheduler/wrangler.jsonc --test-scheduled --persist-to .wrangler/state",
    "records:worker:deploy": "npx wrangler deploy --config workers/records-scheduler/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "6.0.5",
    "@lucia-auth/adapter-sqlite": "^3.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "astro": "^7.3.1",
    "lucia": "^3.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
